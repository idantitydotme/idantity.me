---
import AppLayout from "../../../layouts/AppLayout.astro";
import { t } from "@rimelight/i18n";


---

<AppLayout title={t("assets.title")} description={t("assets.description")}>
        <div class="max-w-4xl mx-auto">
            <header class="mb-12">
                <h1 class="text-4xl font-black mb-4 tracking-tight">{t("assets.heading")}</h1>
                <p class="text-xl text-neutral-500 dark:text-neutral-400">
                    {t("assets.description")}
                </p>
            </header>

            <div class="p-8 border border-neutral-800 rounded-lg text-center bg-neutral-900/40">
                <p class="text-neutral-400">Asset Manager — Astro Refactoring in progress</p>
            </div>

            <section class="mt-16 grid gap-8">
                <div class="p-6 rounded-xl bg-primary-500/5 border border-primary-500/10">
                    <h3 class="text-lg font-bold mb-2 flex items-center gap-2">
                        <span class="size-2 rounded-full bg-primary-500 animate-pulse"></span>
                        {t("assets.devNotes")}
                    </h3>
                    <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400">
                        <li>• Simplified migration from <code>rimelight-components</code></li>
                        <li>• Using plaintext English (no i18n)</li>
                        <li>• Direct Tailwind CSS classes (no variants)</li>
                        <li>• Native browser APIs for clipboard and dialogs</li>
                        <li>• Integrated <code>AssetImage</code> for full previews</li>
                    </ul>
                </div>
            </section>
        </div>
</AppLayout>
