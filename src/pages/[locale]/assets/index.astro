---
import AppLayout from "../../../layouts/AppLayout.astro";
import AssetManagerModalDemo from "../../../components/app/AssetManagerModalDemo.vue";
import { useI18n, currentLocale } from 'astro-nanostores-i18n:runtime';

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const messages = useI18n('assets', {
  title: 'Asset Manager',
  heading: 'Assets',
  description: 'A dedicated test environment for the new simplified asset management system.',
  devNotes: 'Development Notes'
});
---

<AppLayout title={messages.title} description={messages.description}>
        <div class="max-w-4xl mx-auto">
            <header class="mb-12">
                <h1 class="text-4xl font-black mb-4 tracking-tight">{messages.heading}</h1>
                <p class="text-xl text-neutral-500 dark:text-neutral-400">
                    {messages.description}
                </p>
            </header>

            <AssetManagerModalDemo client:only="vue" />

            <section class="mt-16 grid gap-8">
                <div class="p-6 rounded-xl bg-primary-500/5 border border-primary-500/10">
                    <h3 class="text-lg font-bold mb-2 flex items-center gap-2">
                        <span class="size-2 rounded-full bg-primary-500 animate-pulse"></span>
                        {messages.devNotes}
                    </h3>
                    <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400">
                        <li>• Simplified migration from <code>rimelight-components</code></li>
                        <li>• Using plaintext English (no i18n)</li>
                        <li>• Direct Tailwind CSS classes (no variants)</li>
                        <li>• Native browser APIs for clipboard and dialogs</li>
                        <li>• Integrated <code>AssetImage</code> for full previews</li>
                    </ul>
                </div>
            </section>
        </div>
</AppLayout>
