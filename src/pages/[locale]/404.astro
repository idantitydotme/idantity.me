---
import AppLayout from '@/layouts/AppLayout.astro';
import { useI18n, currentLocale } from 'astro-nanostores-i18n:runtime';
import { getRelativeLocaleUrl } from 'astro:i18n';

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const messages = useI18n('errors', {
  notFound: 'Page Not Found',
  notFoundDesc: 'The page you are looking for does not exist.',
  serverError: 'Server Error',
  unknownError: 'Unknown error',
  goHome: 'Go Home'
});
---

<AppLayout title={messages.notFound} description={messages.notFoundDesc}>
  <style slot="head">
    .error-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 60vh;
      text-align: center;
      padding: 2rem;
    }
    .error-code {
      font-size: 6rem;
      font-weight: 900;
      color: var(--accent);
      margin: 0;
      line-height: 1;
    }
    .error-title {
      font-size: 1.5rem;
      margin: 1rem 0 0.5rem;
    }
    .error-desc {
      color: rgb(var(--gray));
      margin-bottom: 2rem;
    }
    .error-link {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
    }
    .error-link:hover {
      text-decoration: underline;
    }
  </style>

  <div class="error-container">
    <p class="error-code">404</p>
    <h1 class="error-title">{messages.notFound}</h1>
    <p class="error-desc">{messages.notFoundDesc}</p>
    <a href={getRelativeLocaleUrl(activeLocale, '/')} class="error-link">{messages.goHome}</a>
  </div>
</AppLayout>
