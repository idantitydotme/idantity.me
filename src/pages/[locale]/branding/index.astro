---
import AppLayout from "@/layouts/AppLayout.astro";
import { useI18n, currentLocale } from 'astro-nanostores-i18n:runtime';

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const messages = useI18n('branding', {
  title: 'Branding',
  description: 'idantity.me Branding Guidelines'
});
---

<AppLayout title={messages.title} description={messages.description}>
  <main>
    <h1>{messages.title}</h1>
    <p>{messages.description}</p>
  </main>
</AppLayout>
