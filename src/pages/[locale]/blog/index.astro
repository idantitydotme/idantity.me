---
import AppLayout from '@/layouts/AppLayout.astro';
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { siteConfig } from "@/config/site.config";
import { useI18nAsync } from "@rimelight/i18n";
import RLAPageSection from "@rimelight/ui/components/page-section/RLAPageSection.astro"
import RLAGrid from "@rimelight/ui/components/grid/RLAGrid.astro"
import RLAPost from "@rimelight/ui/components/post/RLAPost.astro"

const posts = (await getCollection('blog')).toSorted(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const groupedPosts = posts.reduce<Record<string, typeof posts>>((acc, post) => {
	const type = post.data.type;
	if (!acc[type]) acc[type] = [];
	acc[type].push(post);
	return acc;
}, {});

const categoryOrder = ["development-log", "personal-stories", "other"] as const;

const currentLocale = Astro.currentLocale ?? 'en';

const messages = await useI18nAsync(Astro, 'blog', {
	categories: {
  "development-log": "Development Log",
  "personal-stories": "Personal Stories",
  "other": "Other"
} as any
});
---

<AppLayout title={siteConfig.name} description={siteConfig.description}>
		{categoryOrder.map((category) => {
			const categoryPosts = groupedPosts[category];
			if (!categoryPosts || categoryPosts.length === 0) return null;
			return (
				<RLAPageSection title={(messages.categories as unknown as Record<string, string>)[category]}>
					<RLAGrid>
						{
							categoryPosts.map((post) => (
								<RLAPost
									variant="ghost"
									image={post.data.heroImage}
									date={post.data.pubDate}
									title={post.data.title}
									description={post.data.description}
									to={getRelativeLocaleUrl(currentLocale, `/blog/${post.id}/`)}
								/>
							))
						}
					</RLAGrid>
				</RLAPageSection>
			);
		})}
</AppLayout>
