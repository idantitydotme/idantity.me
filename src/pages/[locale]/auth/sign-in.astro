---
import AppLayout from '#layouts/AppLayout.astro'
import AuthLayout from '#layouts/AuthLayout.astro'
import AuthSignInForm from '#components/auth/AuthSignInForm.astro'
import { t, getLocale } from "@rimelight/i18n"
import bgMobile from '#assets/images/auth_background_mobile.jpg'
import bgDesktop from '#assets/images/auth_background_desktop.jpg'

const isNewUser = new URL(Astro.request.url).searchParams.has('new')

const currentPath = Astro.url.pathname
const activeLocale = getLocale()
const localePrefix = `/${activeLocale}`
const tabs = [
  { label: t("page_auth_sign-in.sign-in_title"), path: `${localePrefix}/auth/sign-in` },
  { label: t("page_auth_sign-in.sign-up_title"), path: `${localePrefix}/auth/sign-up` },
]
---

<AppLayout title={t("page_auth_sign-in.meta_title")} description={t("page_auth_sign-in.sign-in_description")}>
  {isNewUser && <p class="text-center text-sm text-success">{t("page_auth_sign-in.sign-in_new-user")}</p>}
  <AuthLayout tabs={tabs} currentPath={currentPath} backgroundMobile={bgMobile.src} backgroundDesktop={bgDesktop.src}>
    <AuthSignInForm />
  </AuthLayout>
</AppLayout>
