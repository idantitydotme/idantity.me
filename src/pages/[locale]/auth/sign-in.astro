---
import AppLayout from '#layouts/AppLayout.astro'
import AuthLayout from '#layouts/AuthLayout.astro'
import AuthSignInForm from '#components/auth/AuthSignInForm.astro'
import { useI18n } from "@rimelight/i18n"
import bgMobile from '#assets/images/auth_background_mobile.jpg'
import bgDesktop from '#assets/images/auth_background_desktop.jpg'

const messages = useI18n(Astro, "page_auth_sign-in", {
  meta_title: 'Sign in',
  'sign-in_title': 'Sign in',
  'sign-in_description': 'Sign in to your account',
  'sign-in_new-user': 'Your account has been created. Please sign in.',
  'sign-in_email': 'E-mail',
  'sign-in_password': 'Password',
  'sign-in_button': 'Sign in',
  'sign-up_title': 'Sign up',
  auth_email_label: 'E-mail',
  auth_email_description: '',
  auth_email_placeholder: 'your@email.com',
  auth_email_invalid: 'Invalid email',
  auth_password_label: 'Password',
  auth_password_description: '',
  auth_password_min_length: 'Password must be at least 8 characters',
  auth_remember_me: 'Remember me',
  auth_sign_in_button: 'Sign in',
  auth_sign_in_failed_title: 'Sign in failed',
  auth_sign_in_success_title: 'Signed in successfully',
  auth_connection_error_description: 'Connection error',
  auth_terms_agreement: 'By signing in you agree to our',
  auth_terms_link: 'Terms of Service',
  'auth_sign-in_email_help': 'Recover email',
  'auth_sign-in_password_help': 'Forgot password?',
})

const isNewUser = new URL(Astro.request.url).searchParams.has('new')

const currentPath = Astro.url.pathname
const activeLocale = Astro.currentLocale ?? "en"
const localePrefix = `/${activeLocale}`
const tabs = [
  { label: messages['sign-in_title'], path: `${localePrefix}/auth/sign-in` },
  { label: messages['sign-up_title'], path: `${localePrefix}/auth/sign-up` },
]
---

<AppLayout title={messages.meta_title} description={messages['sign-in_description']}>
  {isNewUser && <p class="text-center text-sm text-success">{messages['sign-in_new-user']}</p>}
  <AuthLayout tabs={tabs} currentPath={currentPath} backgroundMobile={bgMobile.src} backgroundDesktop={bgDesktop.src}>
    <AuthSignInForm messages={messages} />
  </AuthLayout>
</AppLayout>
