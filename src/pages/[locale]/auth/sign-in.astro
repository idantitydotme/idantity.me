---
import AppLayout from '@/layouts/AppLayout.astro'
import { actions, isInputError } from 'astro:actions'
import Form from '@/components/Form.astro'
import Input from '@/components/Input.astro'
import { useI18n, currentLocale } from 'astro-nanostores-i18n:runtime'

const activeLocale = Astro.currentLocale ?? 'en'
currentLocale.set(activeLocale)
const messages = useI18n('auth', {
  authSignInTitle: 'Sign in',
  authSignInDescription: 'Sign in to your account',
  authSignInNewUserMessage: 'Your account has been created. Please sign in.',
  authSignInEmail: 'E-mail',
  authSignInPassword: 'Password',
  authSignInButton: 'Sign in',
  authSignUpTitle: 'Sign up',
  authSignUpDescription: 'Create a new account',
  authSignUpFirstName: 'First name',
  authSignUpLastName: 'Last name',
  authSignUpEmail: 'E-mail',
  authSignUpPassword: 'Password',
  authSignUpButton: 'Sign up',
  authSignOutTitle: 'Sign out',
  authSignOutDescription: 'Sign out of your account',
  authSignOutConfirmMessage: 'Are you sure you want to sign out?',
  authSignOutButton: 'Sign out'
})

const result = Astro.getActionResult(actions.signIn)

if (result && !result.error && result.data.cookies.length > 0) {
  Astro.response.headers.append('Location', '/')
  Astro.response.status = 302

  for (const cookie of result.data.cookies) {
    Astro.response.headers.append('Set-Cookie', cookie)
  }

  return new Response(null, Astro.response)
}

const inputErrors = isInputError(result?.error) ? result.error.fields : {}
const isNewUser = new URL(Astro.request.url).searchParams.has('new')
---

<AppLayout title={messages.authSignInTitle} description={messages.authSignInDescription}>
  {isNewUser && <p>{messages.authSignInNewUserMessage}</p>}
  <Form method="POST" action={actions.signIn} error={result?.error}>
    <Input errors={inputErrors.email} name="email" label={messages.authSignInEmail} required type="email" />
    <Input errors={inputErrors.password} name="password" label={messages.authSignInPassword} required type="password" />
    <button>{messages.authSignInButton}</button>
  </Form>
</AppLayout>

<style>
  p {
    background-color: var(--sl-color-green-low);
    border: 1px solid var(--sl-color-green);
    color: var(--sl-color-white);
    padding: 0.5rem 1rem;
  }
</style>
