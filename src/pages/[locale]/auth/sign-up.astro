---
import AppLayout from '#layouts/AppLayout.astro'
import AuthLayout from '#layouts/AuthLayout.astro'
import AuthSignUpForm from '#components/auth/AuthSignUpForm.astro'
import { t, getLocale } from "@rimelight/i18n"
import bgMobile from '#assets/images/auth_background_mobile.jpg'
import bgDesktop from '#assets/images/auth_background_desktop.jpg'

const currentPath = Astro.url.pathname
const activeLocale = getLocale()
const localePrefix = `/${activeLocale}`
const tabs = [
  { label: t("page_auth_sign-up.sign-in_title"), path: `${localePrefix}/auth/sign-in` },
  { label: t("page_auth_sign-up.sign-up_title"), path: `${localePrefix}/auth/sign-up` },
]
---

<AppLayout title={t("page_auth_sign-up.meta_title")} description={t("page_auth_sign-up.sign-up_description")}>
  <AuthLayout tabs={tabs} currentPath={currentPath} backgroundMobile={bgMobile.src} backgroundDesktop={bgDesktop.src}>
    <AuthSignUpForm />
  </AuthLayout>
</AppLayout>
