---
import AppLayout from "#layouts/AppLayout.astro";
import RLAContainer from "@rimelight/ui/components/container/RLAContainer.astro"
import RLAPage from "@rimelight/ui/components/page/RLAPage.astro"
import RLAAvatar from "@rimelight/ui/components/avatar/RLAAvatar.astro"
import RLAImage from "@rimelight/ui/components/image/RLAImage.astro"
import RLALink from "@rimelight/ui/components/link/RLALink.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import RLABadge from "@rimelight/ui/components/badge/RLABadge.astro"
import type { ButtonProps } from "@rimelight/ui/components/button/button.ts"
import RLAIcon from "@rimelight/ui/components/icon/RLAIcon.astro"
import RLAProgress from "@rimelight/ui/components/progress/RLAProgress.astro"
import RLATimeline from "@rimelight/ui/components/timeline/RLATimeline.astro"
import RLAPageSection from "@rimelight/ui/components/page-section/RLAPageSection.astro"
import { t, getRelativeLocaleUrl } from "@rimelight/i18n"

// Imprecise but good enough for this use case to avoid adding a date library or larger function.
const age = Math.floor((Date.now() - new Date(1997, 3, 30).getTime()) / (365.25 * 24 * 60 * 60 * 1000));

const aboutDetails = [
  { label: t("page_resume.about_gender_label"), value: t("page_resume.about_gender_value") },
  { label: t("page_resume.about_pronouns_label"), value: t("page_resume.about_pronouns_value") },
  { label: t("page_resume.about_nationality_label"), value: t("page_resume.about_nationality_value") },
  { label: t("page_resume.about_age_label"), value: `${age} ${t("page_resume.about_age_value")}` }
];

const skills = [
  {
    icon: "i-lucide-code-2",
    title: t("page_resume.skills_webDev"),
    description: t("page_resume.skills_webDev_desc")
  },
  {
    icon: "i-lucide-gamepad-2",
    title: t("page_resume.skills_gameDev"),
    description: t("page_resume.skills_gameDev_desc")
  },
  {
    icon: "i-lucide-palette",
    title: t("page_resume.skills_design"),
    description: t("page_resume.skills_design_desc")
  }
];

const techGroups = [
  {
    title: t("page_resume.tech_group_webDev"),
    categories: [
      {
        title: t("page_resume.tech_cat_languages"),
        items: [
          { label: "TypeScript", icon: "i-logos-typescript-icon", href: "https://www.typescriptlang.org/" },
          { label: "Astro", icon: "i-logos-astro-icon", href: "https://astro.build/" },
          { label: "Vue", icon: "i-logos-vue", href: "https://vuejs.org/" },
          { label: "SolidJS", icon: "i-logos-solidjs-icon", href: "https://www.solidjs.com/" },
          { label: "UnoCSS", icon: "i-logos-unocss", href: "https://unocss.dev/" }
        ]
      },
      {
        title: t("page_resume.tech_cat_environment"),
        items: [
          { label: "WebStorm", icon: "i-logos-webstorm", href: "https://www.jetbrains.com/webstorm/" }
        ]
      },
      {
        title: t("page_resume.tech_cat_build"),
        items: [
          { label: "Vite-plus", icon: "i-logos-vitejs", href: "https://vite.dev/" },
          { label: "pnpm", icon: "i-logos-pnpm", href: "https://pnpm.io/" }
        ]
      },
      {
        title: t("page_resume.tech_cat_deployment"),
        items: [
          { label: "Cloudflare", icon: "i-logos-cloudflare-icon", href: "https://cloudflare.com/" }
        ]
      }
    ]
  },
  {
    title: t("page_resume.tech_group_gameDev"),
    categories: [
      {
        title: t("page_resume.tech_cat_languages"),
        items: [
          { label: "C++", icon: "i-logos-c-plusplus", href: "https://isocpp.org/" },
          { label: "Verse", icon: "i-simple-icons-fortnite", href: "https://dev.epicgames.com/documentation/en-us/uefn/verse-language-reference" }
        ]
      },
      {
        title: t("page_resume.tech_cat_environment"),
        items: [
          { label: "Unreal Engine", icon: "i-logos-unrealengine-icon?mask text-white", href: "https://www.unrealengine.com/" },
          { label: "Rider", icon: "i-logos-rider", href: "https://www.jetbrains.com/rider/" }
        ]
      }
    ]
  },
  {
    title: t("page_resume.tech_group_shared"),
    categories: [
      {
        title: t("page_resume.tech_cat_data"),
        items: [
          { label: "PostgreSQL", icon: "i-logos-postgresql", href: "https://www.postgresql.org/" },
          { label: "Drizzle", icon: "i-catppuccin-drizzle-orm", href: "https://orm.drizzle.team/" }
        ]
      },
      {
        title: t("page_resume.tech_cat_auth"),
        items: [
          { label: "Cloudflare Access", icon: "i-simple-icons-cloudflare", href: "https://cloudflare.com/" }
        ]
      },
      {
        title: t("page_resume.tech_cat_project"),
        items: [
          { label: "Git", icon: "i-logos-git-icon", href: "https://git-scm.com/" },
          { label: "Lore", icon: "i-simple-icons-epicgames?mask text-white", href: "https://dev.epicgames.com/documentation/en-us/uefn/unreal-revision-control-in-unreal-editor-for-fortnite" },
          { label: "YouTrack", icon: "i-logos-youtrack", href: "https://www.jetbrains.com/youtrack/" }
        ]
      }
    ]
  }
];

// Availability state presets: 'available' | 'busy' | 'looking'
const availabilityStatus: 'available' | 'busy' | 'looking' = 'available';

const availabilityConfig = {
  available: {
    labelKey: "sidebar_availability_available" as const,
    colorClass: "bg-success-500",
    ping: true
  },
  busy: {
    labelKey: "sidebar_availability_busy" as const,
    colorClass: "bg-error-500",
    ping: false
  },
  looking: {
    labelKey: "sidebar_availability_looking" as const,
    colorClass: "bg-warning-500",
    ping: true
  }
};

const currentAvailability = availabilityConfig[availabilityStatus];

const socials = [
  {
    size: "lg",
    variant: "ghost" as const,
    leadingIcon: "i-logos-linkedin-icon?mask text-white hover:text-primary-500",
    href: "https://linkedin.com/daniel-marchi",
    ariaLabel: "LinkedIn"
  },
  {
    size: "lg",
    variant: "ghost" as const,
    leadingIcon: "i-logos-github-icon?mask text-white hover:text-primary-500",
    href: "https://github.com/idantitydotme",
    ariaLabel: "GitHub"
  }
];

const languages = [
  {
    nameKey: "lang_portuguese" as const,
    levelKey: "level_fluent" as const,
    score: 100
  },
  {
    nameKey: "lang_english" as const,
    levelKey: "level_fluent" as const,
    score: 100
  },
  {
    nameKey: "lang_spanish" as const,
    levelKey: "level_intermediate" as const,
    score: 50
  },
  {
    nameKey: "lang_romanian" as const,
    levelKey: "level_basic" as const,
    score: 25
  }
];

const heroLinks: ButtonProps[] = [
  {
    label: t("page_resume.hero_action_hire") ?? "",
    href: getRelativeLocaleUrl("/contact"),
  },
  {
    variant: "outline",
    label: t("page_resume.hero_action_downloadCv") ?? "",
    href: "https://cdn.idantity.me/Documents/Daniel_Marchi_CV.pdf",
    leadingIcon: "i-lucide-download"
  }
];

export interface ExperienceItem {
  role: string;
  company: string;
  companyUrl?: string;
  image?: string;
  period: string;
  location?: string;
  summary?: string;
  responsibilities?: string[];
  tags?: string[];
}

const experiences: [ExperienceItem, ExperienceItem, ExperienceItem] = [
  {
    role: t("page_resume.exp_role_0") ?? "",
    company: t("page_resume.exp_company_0") ?? "",
    companyUrl: "https://compass.uol",
    period: t("page_resume.exp_period_0") ?? "",
    location: "Curitiba, Brazil · Remote",
    summary: t("page_resume.exp_summary_0") ?? "",
    responsibilities: [
      t("page_resume.exp_bullet_0_0") ?? "",
      t("page_resume.exp_bullet_0_1") ?? "",
      t("page_resume.exp_bullet_0_2") ?? ""
    ],
    tags: ["Unreal Engine", "C++", "3D Web", "UI Design"]
  },
  {
    role: t("page_resume.exp_role_1") ?? "",
    company: t("page_resume.exp_company_1") ?? "",
    companyUrl: "https://compass.uol",
    period: t("page_resume.exp_period_1") ?? "",
    location: "Curitiba, Brazil · Remote",
    summary: t("page_resume.exp_summary_1") ?? "",
    responsibilities: [
      t("page_resume.exp_bullet_1_0") ?? ""
    ],
    tags: ["Unreal Engine", "Blueprints", "E-Commerce"]
  },
  {
    role: t("page_resume.exp_role_2") ?? "",
    company: t("page_resume.exp_company_2") ?? "",
    companyUrl: "https://compass.uol",
    period: t("page_resume.exp_period_2") ?? "",
    location: "Curitiba, Brazil · Remote",
    summary: t("page_resume.exp_summary_2") ?? "",
    responsibilities: [
      t("page_resume.exp_bullet_2_0") ?? ""
    ],
    tags: ["Unreal Engine", "C++", "Gameplay"]
  }
];

const education = [
  {
    degree: t("page_resume.edu_degree_0"),
    school: t("page_resume.edu_school_0"),
    period: t("page_resume.edu_period_0")
  },
  {
    degree: t("page_resume.edu_degree_1"),
    school: t("page_resume.edu_school_1"),
    period: t("page_resume.edu_period_1")
  }
];

const certifications = [
  {
    title: "HTML Essential Training",
    issuer: "LinkedIn Learning",
    credentialId: "d9e4078228ebbdb4def6e76b7920e52d10faa00f26f243028ed899965520c5b9"
  },
  {
    title: "CSS Essential Training",
    issuer: "LinkedIn Learning",
    credentialId: "39bbac502a6eb3234012f41377b0ef184f472af2c60cd01818700a4cb3043328"
  },
  {
    title: "TypeScript Essential Training",
    issuer: "LinkedIn Learning",
    credentialId: "b9bbfd92aed3215801a32b67dd509d93d435582908129025b29fb233460eb0d7"
  },
  {
    title: "PostgreSQL Essential Training",
    issuer: "LinkedIn Learning",
    credentialId: "f1debffcb0dce6fb5e583570c50932b55a16b55bd66c8b285677546553d0c733"
  },
  {
    title: "Git Essential Training",
    issuer: "LinkedIn Learning",
    credentialId: "0f4be14114c8a49d3554f670afab6ea33616c21e056991ad9478cb87345eaa34"
  },
  {
    title: "Unreal Engine 5 Essential Training",
    issuer: "LinkedIn Learning",
    credentialId: "d1cb7ca7162be843536829874461164f5fc317707e0c3bbeae167dc7c9038630"
  }
];

const projects = [
  {
    imageSrc: "https://cdn.idantity.me/images/placeholder.webp",
    name: t("page_resume.project_lumen_name"),
    period: "2025",
    description: t("page_resume.project_lumen_description"),
    solution: t("page_resume.project_lumen_solution"),
    impact: t("page_resume.project_lumen_impact"),
    technologies: {
      categories: [
        {
          name: "FRONTEND",
          items: ["TypeScript", "Astro", "UnoCSS", "Responsive Design"]
        },
        {
          name: "PERFORMANCE",
          items: ["Asset Optimization", "Lazy Loading", "Image CDN"]
        }
      ]
    }
  }
];
---

<AppLayout title={t("page_resume.meta_title")} description={t("page_resume.meta_description")}>
  <RLAContainer class="max-w-none">
    <RLAPage>
      <div class="flex flex-col md:flex-row gap-xl">
        <!-- Left Sidebar -->
        <aside aria-label="Profile" class="flex flex-col w-full gap-xl py-16 md:w-80 shrink-0 border-b md:border-b-0 md:border-r border-primary-500 md:pr-8">
          <!-- Introduction Section -->
          <section class="flex flex-col items-center">
            <header class="flex flex-col gap-xs items-center">
              <RLAAvatar
                src="https://cdn.idantity.me/Images/Users/Avatars/idantity.me_0000_00.webp"
                alt="Daniel Marchi"
                class="!size-40 border-4 border-primary-500 shadow-xl"
              />

              <div class="text-center">
                <h2 class="text-3xl font-bold">{t("page_resume.sidebar_name")}</h2>
                <p class="text-md text-neutral-500">{t("page_resume.sidebar_title")}</p>
              </div>
            </header>

            <!-- Availability Status Indicator -->
            <RLAButton
              href={getRelativeLocaleUrl("/contact")}
              variant="ghost"
              color="success"
              class="w-full justify-center text-sm font-bold"
            >
              <span class="relative flex size-2.5 mr-2">
                {currentAvailability.ping && (
                  <span class={`absolute inline-flex size-full animate-ping rounded-full opacity-75 ${currentAvailability.colorClass}`} />
                )}
                <span class={`relative inline-flex size-2.5 rounded-full ${currentAvailability.colorClass}`} />
              </span>
              {t(`page_resume.${currentAvailability.labelKey}`)}
            </RLAButton>

            <!-- Socials -->
            <ul class="flex flex-row gap-sm justify-center w-full">
              {socials.map((social) => (
                <li>
                  <RLAButton
                    size={social.size}
                    variant={social.variant}
                    leadingIcon={social.leadingIcon}
                    href={social.href}
                    aria-label={social.ariaLabel}
                  />
                </li>
              ))}
            </ul>
          </section>

          <!-- About Me Section -->
          <section class="flex flex-col gap-sm">
            <header class="flex flex-col gap-2">
              <div class="flex flex-row items-center gap-2">
                <RLAIcon name="i-lucide-user" class="text-sm" />
                <h3 class="text-md font-bold">{t("page_resume.about_heading")}</h3>
              </div>
              <hr class="border-neutral-500" />
            </header>
            <dl class="flex flex-col gap-sm text-sm text-neutral-500">
              {aboutDetails.map((item) => (
                <div class="flex justify-between">
                  <dt>{item.label}</dt>
                  <dd class="text-neutral-500">{item.value}</dd>
                </div>
              ))}
              <div class="flex justify-between items-center pb-1.5">
                <dt>Location</dt>
                <dd>
                  <RLALink
                    leadingIcon="i-lucide-map-pin"
                    label={t("page_resume.sidebar_location")}
                    href="https://en.wikipedia.org/wiki/Curitiba"
                    class="text-sm hover:text-primary-400"
                  />
                </dd>
              </div>
            </dl>
          </section>

          <!-- Languages Section -->
          <section class="flex flex-col gap-sm">
            <header class="flex flex-col gap-2">
              <div class="flex flex-row items-center gap-2">
                <RLAIcon name="i-lucide-languages" class="text-sm" />
                <h3 class="text-md font-bold">{t("page_resume.languages_heading")}</h3>
              </div>
              <hr class="border-neutral-500" />
            </header>
            <dl class="flex flex-col gap-sm">
              {languages.map((language) => (
                <div class="flex flex-col gap-xs">
                  <div class="flex flex-row justify-between items-center text-sm">
                    <dt>{t(`page_resume.${language.nameKey}`)}</dt>
                    <dd class="text-sm text-neutral-500">{t(`page_resume.${language.levelKey}`)}</dd>
                  </div>
                  <RLAProgress size="sm" value={language.score}/>
                </div>
              ))}
            </dl>
          </section>
        </aside>

        <!-- Page Body -->
        <article class="flex flex-col gap-xl py-8 md:py-16 flex-1">
          <RLAPageSection
            variant="hero"
            orientation="horizontal"
            title={t("page_resume.hero_title")}
            description={t("page_resume.hero_description")}
            links={heroLinks}
          >
            <RLAImage
              src="https://cdn.idantity.me/Images/Users/Avatars/idantity.me_0000_00.webp"
              alt="Daniel Marchi"
              width={800}
              height={800}
            />
          </RLAPageSection>

          <!-- Skills Section -->
          <section class="flex flex-col gap-md">
            <header class="flex flex-col gap-xs">
              <h2 class="text-3xl font-bold">{t("page_resume.skills_heading")}</h2>
              <hr class="border-neutral-500" />
            </header>
            <ul class="grid grid-cols-1 md:grid-cols-3 gap-lg">
              {skills.map((skill) => (
                <li>
                  <div class="flex items-center gap-sm">
                    <RLAIcon name={skill.icon} size="lg" class="text-primary-500" />
                    <h3 class="text-lg font-bold">{skill.title}</h3>
                  </div>
                  <p class="text-sm text-neutral-500">
                    {skill.description}
                  </p>
                </li>
              ))}
            </ul>
          </section>

          <!-- Technologies & Tools Section -->
          <section class="flex flex-col gap-md">
            <header class="flex flex-col gap-xs">
              <h2 class="text-3xl font-bold">{t("page_resume.tech_heading")}</h2>
              <hr class="border-neutral-500" />
            </header>

            {techGroups.map((group) => (
              <>
                <div class="flex flex-col gap-sm">
                  <h3 class="text-lg font-bold">{group.title}</h3>
                  <hr class="border-neutral-500" />
                </div>

                <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-lg">
                  {group.categories.map((category) => (
                    <li class="flex flex-col gap-md items-start text-left">
                      <h4 class="text-sm font-bold">{category.title}</h4>
                      <ul class="flex flex-col gap-xs w-full items-start">
                        {category.items.map((item) => (
                          <li class="w-full">
                            <RLAButton
                              block
                              justify="start"
                              variant="ghost"
                              color="neutral"
                              leadingIcon={item.icon}
                              href={item.href}
                              label={item.label}
                              class="text-sm"
                            />
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>
              </>
            ))}
          </section>

          <!-- Experience Section -->
          <section class="flex flex-col gap-md">
            <header class="flex flex-col gap-xs">
              <h2 class="text-3xl font-bold">{t("page_resume.experience_heading")}</h2>
              <hr class="border-neutral-500" />
            </header>
            <RLATimeline
              orientation="vertical"
              size="xl"
              class="w-full"
              items={experiences.map((exp, idx) => ({
                slot: `exp-${idx}`,
                date: exp.period,
                title: `${exp.role} @ ${exp.company}`,
                avatar: exp.image ? { src: exp.image, alt: exp.company } : undefined,
                icon: exp.image ? undefined : "i-lucide-briefcase"
              }))}
            >
              <div slot="exp-0-description" class="flex flex-col gap-2">
                {experiences[0].location && <p class="text-sm text-neutral-500">{experiences[0].location}</p>}
                {experiences[0].tags && experiences[0].tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {experiences[0].tags.map((tag) => (
                      <RLABadge variant="outline">
                        {tag}
                      </RLABadge>
                    ))}
                  </div>
                )}
                {experiences[0].summary && (
                  <div>
                    <span class="text-sm font-bold text-neutral-500 block">{t("page_resume.exp_summary_label")}:</span>
                    <p class="text-sm text-neutral-500">{experiences[0].summary}</p>
                  </div>
                )}
                {experiences[0].responsibilities && experiences[0].responsibilities.length > 0 && (
                  <div>
                    <span class="text-sm font-bold text-neutral-500 block">{t("page_resume.exp_responsibilities_label")}:</span>
                    <ul class="space-y-1 pl-4 list-disc text-sm text-neutral-500">
                      {experiences[0].responsibilities.map((resp) => <li class="text-neutral-500">{resp}</li>)}
                    </ul>
                  </div>
                )}
              </div>

              <div slot="exp-1-description" class="flex flex-col gap-2">
                {experiences[1].location && <p class="text-sm text-neutral-500">{experiences[1].location}</p>}
                {experiences[1].tags && experiences[1].tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {experiences[1].tags.map((tag) => (
                      <RLABadge variant="outline">
                        {tag}
                      </RLABadge>
                    ))}
                  </div>
                )}
                {experiences[1].summary && (
                  <div>
                    <span class="text-sm font-bold text-neutral-500 block">{t("page_resume.exp_summary_label")}:</span>
                    <p class="text-sm text-neutral-500">{experiences[1].summary}</p>
                  </div>
                )}
                {experiences[1].responsibilities && experiences[1].responsibilities.length > 0 && (
                  <div>
                    <span class="text-sm font-bold text-neutral-500 block">{t("page_resume.exp_responsibilities_label")}:</span>
                    <ul class="space-y-1 pl-4 list-disc text-sm text-neutral-500">
                      {experiences[1].responsibilities.map((resp) => <li class="text-neutral-500">{resp}</li>)}
                    </ul>
                  </div>
                )}
              </div>

              <div slot="exp-2-description" class="flex flex-col gap-2">
                {experiences[2].location && <p class="text-sm text-neutral-500">{experiences[2].location}</p>}
                {experiences[2].tags && experiences[2].tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {experiences[2].tags.map((tag) => (
                      <RLABadge variant="outline">
                        {tag}
                      </RLABadge>
                    ))}
                  </div>
                )}
                {experiences[2].summary && (
                  <div>
                    <span class="text-sm font-bold text-neutral-500 block">{t("page_resume.exp_summary_label")}:</span>
                    <p class="text-sm text-neutral-500">{experiences[2].summary}</p>
                  </div>
                )}
                {experiences[2].responsibilities && experiences[2].responsibilities.length > 0 && (
                  <div>
                    <span class="text-sm font-bold text-neutral-500 block">{t("page_resume.exp_responsibilities_label")}:</span>
                    <ul class="space-y-1 pl-4 list-disc text-sm text-neutral-500">
                      {experiences[2].responsibilities.map((resp) => <li class="text-neutral-500">{resp}</li>)}
                    </ul>
                  </div>
                )}
              </div>
            </RLATimeline>
          </section>

          <!-- Education Section -->
          <section class="flex flex-col gap-md">
            <header class="flex flex-col gap-xs">
              <h2 class="text-3xl font-bold">{t("page_resume.education_heading")}</h2>
              <hr class="border-neutral-500" />
            </header>
            <RLATimeline
              orientation="vertical"
              size="xl"
              items={education.map((edu) => ({
                date: edu.period,
                title: edu.degree,
                description: edu.school,
                icon: "i-lucide-graduation-cap"
              }))}
            />
          </section>

          <!-- Projects Section -->
          <section class="flex flex-col gap-md">
            <header class="flex flex-col gap-xs">
              <h2 class="text-3xl font-bold">{t("page_resume.projects_heading")}</h2>
              <hr class="border-neutral-500" />
            </header>
            <div class="flex flex-col gap-xl">
              {
                projects.map((project) => (
                  <div class="flex flex-col gap-md">
                    <div class="flex flex-row justify-between items-start">
                      <h3 class="text-lg font-bold">{project.name}</h3>
                      <span class="text-sm text-neutral-500">{project.period}</span>
                    </div>

                    <div class="relative w-full aspect-[21/9] overflow-hidden rounded-xl">
                      <RLAImage
                        src={project.imageSrc}
                        alt={project.name}
                        class="absolute inset-0 w-full h-full object-cover"
                      />
                    </div>
                    <p class="text-sm text-neutral-500">{project.description}</p>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-lg border-t border-neutral-500 pt-md">
                      <div>
                        <h4 class="text-sm font-bold">{t("page_resume.projects_solution_label")}</h4>
                        <p class="text-sm text-neutral-500">{project.solution}</p>
                      </div>

                      <div>
                        <h4 class="text-sm font-bold">{t("page_resume.projects_impact_label")}</h4>
                        <p class="text-sm text-neutral-500">{project.impact}</p>
                      </div>
                    </div>

                    <div>
                      <h4 class="text-sm font-bold">{t("page_resume.projects_techs_label")}</h4>
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {
                          project.technologies.categories.map((category) => (
                            <div class="flex flex-col gap-xs">
                              <h5 class="text-sm font-bold text-neutral-500">{category.name}</h5>
                              <div class="flex flex-wrap gap-1.5">
                                {
                                  category.items.map((tech) => (
                                    <RLABadge variant="outline">
                                      {tech}
                                    </RLABadge>
                                  ))
                                }
                              </div>
                            </div>
                          ))
                        }
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Certifications Section -->
          <section class="flex flex-col gap-md">
            <header class="flex flex-col gap-xs">
              <h2 class="text-3xl font-bold">{t("page_resume.certifications_heading") ?? "Certifications"}</h2>
              <hr class="border-neutral-500" />
            </header>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-lg">
              {certifications.map((cert) => (
                <details class="group cursor-pointer flex flex-col gap-1.5">
                  <summary class="list-none [&::-webkit-details-marker]:hidden flex items-start justify-between gap-sm select-none">
                    <div class="flex flex-col">
                      <h3 class="text-lg font-bold group-hover:text-primary-500 transition-colors">{cert.title}</h3>
                      <span class="text-sm text-neutral-500">{cert.issuer}</span>
                    </div>
                    {cert.credentialId && (
                      <span class="i-lucide-chevron-down text-neutral-500 transition-transform duration-200 group-open:rotate-180" />
                    )}
                  </summary>
                  {cert.credentialId && (
                    <code class="block text-sm text-neutral-500 break-all">
                      ID: {cert.credentialId}
                    </code>
                  )}
                </details>
              ))}
            </div>
          </section>
        </article>
      </div>
    </RLAPage>
  </RLAContainer>
</AppLayout>
