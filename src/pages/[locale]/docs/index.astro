---
import { getEntry, render, getCollection } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";
import type { TableOfContentsConfig } from "@rimelight/docs";
import { getDocsVersions, parseDocsSlug } from "@rimelight/docs";

const activeLocale = Astro.currentLocale ?? "en";

const allDocs = await getCollection("docs");
const versions = getDocsVersions(allDocs, activeLocale);
const { activeVersion, contentPath, includeVersionInUrl } = parseDocsSlug(undefined, versions);

if (includeVersionInUrl) {
  return Astro.redirect(`/${activeLocale}/docs/${activeVersion}/`);
}

const entryKey = contentPath === "index"
  ? (activeVersion ? `${activeVersion}/${activeLocale}` : activeLocale)
  : (activeVersion ? `${activeVersion}/${activeLocale}/${contentPath}` : `${activeLocale}/${contentPath}`);

const entry = await getEntry("docs", entryKey);

if (!entry) {
  return Astro.redirect("/404");
}

const { Content, headings } = await render(entry);
const { title, description, tableOfContents, prev, next, editUrl } = entry.data;
---

<DocsLayout
  title={title}
  description={description}
  headings={headings}
  tableOfContents={tableOfContents as TableOfContentsConfig | false | undefined}
  prevOverride={prev}
  nextOverride={next}
  editUrl={editUrl}
  rawMarkdown={entry.body}
  activeVersion={activeVersion}
  versions={versions}
  includeVersionInUrl={includeVersionInUrl}
>
  <Content />
</DocsLayout>
