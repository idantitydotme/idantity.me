---
import EmailPreviewLayout from "#components/email/EmailPreviewLayout.astro"
import SignupNotificationEmail from "#components/email/SignupNotificationEmail.astro"
import { getEmailMessages } from "#auth/email/messages"

const signInUrl = "http://localhost:4321/auth/sign-in"
const messages = getEmailMessages(Astro.params["locale"])
---

<EmailPreviewLayout template="signup-notification" title="Sign-up Notification">
  <SignupNotificationEmail signInUrl={signInUrl} messages={messages} />
</EmailPreviewLayout>
