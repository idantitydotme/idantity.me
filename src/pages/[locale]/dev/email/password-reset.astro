---
import EmailPreviewLayout from "#components/email/EmailPreviewLayout.astro"
import PasswordResetEmail from "#components/email/PasswordResetEmail.astro"
import { getEmailMessages } from "#auth/email/messages"

const url = "http://localhost:4321/auth/reset-password?token=fake-token-123"
const messages = getEmailMessages(Astro.params["locale"])
---

<EmailPreviewLayout template="password-reset" title="Password Reset">
  <PasswordResetEmail url={url} messages={messages} />
</EmailPreviewLayout>
