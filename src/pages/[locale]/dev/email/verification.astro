---
import EmailPreviewLayout from "#components/email/EmailPreviewLayout.astro"
import VerificationEmail from "#components/email/VerificationEmail.astro"
import { getEmailMessages } from "#auth/email/messages"

const url = "http://localhost:4321/api/auth/verify-email?token=fake-token-123"
const messages = getEmailMessages(Astro.params["locale"])
---

<EmailPreviewLayout template="verification" title="Verify Email">
  <VerificationEmail url={url} messages={messages} />
</EmailPreviewLayout>
