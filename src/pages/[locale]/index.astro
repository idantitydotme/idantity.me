---
import AppLayout from "@/layouts/AppLayout.astro";
import { siteConfig } from "@/site.config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import RLASection from "@rimelight/ui/components/astro/RLASection.astro";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import RLAEmbedYoutube from "@rimelight/ui/components/astro/RLAEmbedYoutube.astro";
import { BlogPosts, BlogPost } from "@rimelight/ui/nuxt";
import { Image } from "astro:assets";

import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";

const activeLocale = Astro.currentLocale ?? "en";
currentLocale.set(activeLocale);

const messages = useI18n("home", {
  heroTitle: "We are Rimelight Entertainment",
  heroDescription: "We are creators of Grand Tale.",
  heroJoinUs: "Join Us",
  heroLearnMore: "Learn More",
  companyTitle: "Pushing the boundaries of {interactive}",
  companyDescription: "Founded in 2023, Rimelight Entertainment is independent and player-focused. We don't just create games; we create living, breathing worlds that respect your time and intelligence.",
  companyStatsTitles: "Titles in Development",
  companyStatsCreators: "Global Creators",
  projectsTitle: "Our Projects",
  projectsTagsFranchise: "Franchise",
  projectsTagsFantasy: "Fantasy",
  projectsTagsSocial: "Social",
  projectsContentGrandTaleDescription: "A high-fantasy social life-sim game which hosts sub-games of multiple genres.",
  projectsActionsDiscover: "Discover",
  newsTitle: "Latest News",
  newsDescription: "Read our latest news, posts, and project updates.",
  newsActionsViewAll: "View All News",
  ctaTitle: "Ready to play?",
  ctaDescription: "Join us and let's tell our story together.",
  ctaActionsCreateAccount: "Create Account",
  ctaActionsExploreCareers: "Explore Careers"
});

import HeroBg from "@/assets/placeholder_home_hero_background.png";
import CompanyBg from "@/assets/placeholder_home_company_background.jpg";
import ProjectsBg from "@/assets/placeholder_home_projects_background.jpg";
import GrandTaleImg from "@/assets/placeholder_home_projects_grand-tale.png";
import NewsBg from "@/assets/placeholder_home_news_background.jpg";
import CtaBg from "@/assets/placeholder_home_cta_background.jpg";

const latestPosts = (await getCollection("blog"))
    .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);

const heroLinks = [
  {
    label: messages.heroJoinUs,
    href: getRelativeLocaleUrl(activeLocale, "/auth/sign-up"),
    color: "blurple" as const,
    variant: "solid" as const,
    class: "px-8 py-3 rounded-md font-bold transition-all duration-300 transform hover:scale-[1.03]"
  },
  {
    label: messages.heroLearnMore,
    href: getRelativeLocaleUrl(activeLocale, "/company/about"),
    color: "neutral" as const,
    variant: "outline" as const,
    trailingIcon: "i-lucide-arrow-right",
    class: "text-white ring-white bg-transparent hover:bg-white hover:text-black px-8 py-3 rounded-md font-bold transition-all duration-300 transform hover:scale-[1.03]"
  }
];

const ctaLinks = [
  {
    label: messages.ctaActionsCreateAccount,
    href: getRelativeLocaleUrl(activeLocale, "/auth/sign-up"),
    color: "blurple" as const,
    variant: "solid" as const,
    class: "px-8 py-3 rounded-md font-bold transition-all duration-300 transform hover:scale-[1.03]"
  },
  {
    label: messages.ctaActionsExploreCareers,
    href: getRelativeLocaleUrl(activeLocale, "/company/careers"),
    color: "neutral" as const,
    variant: "outline" as const,
    class: "text-white ring-white bg-transparent hover:bg-white hover:text-black px-8 py-3 rounded-md font-bold transition-all duration-300 transform hover:scale-[1.03]"
  }
];
---

<AppLayout title={siteConfig.name} description={siteConfig.description}>
  <main class="!w-full !max-w-none !m-0 !p-0 min-h-screen bg-black text-white overflow-hidden">
    <RLASection
        variant="hero"
        reverse={true}
        title={messages.heroTitle}
        description={messages.heroDescription}
        links={heroLinks}
        ui={{
          title: "text-white",
          description: "text-neutral-300"
        }}
    >
      <div slot="background" class="w-full h-full">
        <Image
            src={HeroBg}
            alt="Hero Background"
            class="h-full w-full object-cover"
            loading="eager"
        />
        <div class="absolute inset-0 bg-black/45" />
      </div>

      <RLALogo class="pointer-events-none h-64 w-auto text-white" variant="logomark" mode="white" />
    </RLASection>

    <RLASection
        orientation="horizontal"
        title={messages.companyTitle.replace("{interactive}", "interactive media")}
        description={messages.companyDescription}
        ui={{
          title: "text-white",
          description: "text-neutral-300"
        }}
    >
      <div slot="background" class="w-full h-full">
        <Image
            src={CompanyBg}
            alt="Company Background"
            class="h-full w-full object-cover opacity-10"
        />
        <div class="absolute inset-0 bg-black/90" />
      </div>

      <div slot="body" class="grid grid-cols-2 gap-lg mt-8 border-t border-neutral-800/50 pt-8 max-w-xl">
        <div>
          <div class="text-4xl lg:text-5xl font-black text-white tracking-tight">3+</div>
          <div class="text-xs text-neutral-500 font-bold uppercase tracking-widest mt-1">
            {messages.companyStatsTitles}
          </div>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-black text-white tracking-tight">50+</div>
          <div class="text-xs text-neutral-500 font-bold uppercase tracking-widest mt-1">
            {messages.companyStatsCreators}
          </div>
        </div>
      </div>

      <div class="flex items-center justify-center lg:pl-12 w-full mt-10 lg:mt-0">
        <RLAEmbedYoutube
            src="https://www.youtube.com/watch?v=uH1Hw6SDI1M"
            title="We are Rimelight Entertainment"
            class="aspect-video w-full max-w-2xl overflow-hidden rounded-2xl shadow-2xl border border-neutral-800"
        />
      </div>
    </RLASection>

    <RLASection
        orientation="vertical"
        title={messages.projectsTitle}
        class="w-full relative z-10 py-24 bg-black border-t border-neutral-900"
        ui={{
          title: "text-white text-4xl lg:text-5xl font-extrabold uppercase tracking-tight text-center",
          description: "hidden"
        }}
    >
      <div slot="background" class="w-full h-full">
        <Image
            src={ProjectsBg}
            alt="Projects Background"
            class="h-full w-full object-cover opacity-15"
        />
        <div class="absolute inset-0 bg-neutral-950/80" />
      </div>

      <div slot="body" class="flex flex-wrap justify-center gap-lg mt-12 w-full max-w-7xl mx-auto px-4">
        <a
            href={getRelativeLocaleUrl(activeLocale, "/franchises/grand-tale")}
            class="block relative h-128 w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.5rem)] group rounded-2xl overflow-hidden shadow-2xl border border-neutral-800 transition-all duration-300"
        >
          <div class="relative h-full w-full overflow-hidden isolate transition-transform duration-700 ease-out group-hover:scale-[1.02] rounded-[inherit] will-change-transform bg-neutral-900">
            <div class="absolute inset-0 z-0 overflow-hidden rounded-[inherit]">
              <Image
                  alt="Grand Tale"
                  src={GrandTaleImg}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110 will-change-transform opacity-75"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/40 to-transparent" />
            </div>

            <div class="absolute inset-0 p-lg flex flex-col gap-sm justify-end z-10">
              <div class="flex gap-sm">
                <span class="text-white text-xs font-bold uppercase tracking-wider bg-primary-500 px-3 py-1 rounded-full shadow-md">
                  {messages.projectsTagsFranchise}
                </span>
                <span class="text-white text-xs font-bold uppercase tracking-wider bg-primary-500 px-3 py-1 rounded-full shadow-md">
                  {messages.projectsTagsFantasy}
                </span>
                <span class="text-white text-xs font-bold uppercase tracking-wider bg-primary-500 px-3 py-1 rounded-full shadow-md">
                  {messages.projectsTagsSocial}
                </span>
              </div>

              <h3 class="text-3xl font-extrabold uppercase text-white mt-2 tracking-tight">
                Grand Tale
              </h3>

              <p class="text-neutral-300 text-sm mt-1 leading-relaxed">
                {messages.projectsContentGrandTaleDescription}
              </p>

              <div class="flex items-center text-primary-400 font-bold uppercase tracking-widest text-xs mt-4 group-hover:text-primary-300 transition-colors">
                <span>{messages.projectsActionsDiscover}</span>
                <svg class="h-4 w-4 ml-1 transition-transform group-hover:translate-x-1.5 duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </div>
        </a>
      </div>
    </RLASection>

    <RLASection
        orientation="vertical"
        title={messages.newsTitle}
        description={messages.newsDescription}
        class="w-full relative z-10 py-24 bg-neutral-950 border-t border-neutral-900"
        ui={{
          title: "text-white text-4xl lg:text-5xl font-extrabold uppercase tracking-tight text-center",
          description: "text-neutral-400 text-center max-w-2xl mx-auto mt-4"
        }}
    >
      <div slot="background" class="w-full h-full">
        <Image
            src={NewsBg}
            alt="News Background"
            class="h-full w-full object-cover opacity-15"
        />
        <div class="absolute inset-0 bg-black/85" />
      </div>

      <div slot="body" class="w-full mt-12 max-w-7xl mx-auto px-4">
        <BlogPosts client:load class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            latestPosts.map((post) => (
                <BlogPost
                    client:load
                    title={post.data.title}
                    description={post.data.description}
                    date={post.data.pubDate}
                    image={post.data.heroImage}
                    to={getRelativeLocaleUrl(activeLocale, `/blog/${post.id}/`)}
                    variant="soft"
                    ui={{
                      image: 'object-center object-cover h-48 w-full group-hover:scale-105 transition-transform duration-500',
                      title: 'text-black font-semibold text-xl mt-2 line-clamp-2',
                      description: 'text-neutral-600 text-sm mt-1 line-clamp-3'
                    }}
                    class="bg-white rounded-2xl shadow-xl overflow-hidden border border-neutral-100 group transition-all duration-300 hover:shadow-2xl"
                />
            ))
          }
        </BlogPosts>

        {latestPosts.length > 0 && (
            <div class="flex justify-center mt-14">
              <RLAButton
                  label={messages.newsActionsViewAll}
                  href={getRelativeLocaleUrl(activeLocale, "/blog")}
                  color="primary"
                  variant="link"
                  trailingIcon="i-lucide-arrow-right"
                  class="font-bold uppercase tracking-widest text-primary-500 hover:text-primary-400 transition-colors flex items-center gap-xs"
              />
            </div>
        )}
      </div>
    </RLASection>

    <RLASection
        variant="cta"
        ctaVariant="solid"
        title={messages.ctaTitle}
        description={messages.ctaDescription}
        links={ctaLinks}
        class="w-full relative z-10 py-24 bg-black border-t border-neutral-900 rounded-none overflow-hidden"
        ui={{
          title: "text-white text-5xl lg:text-6xl font-black uppercase tracking-tight text-center leading-none",
          description: "text-neutral-300 text-lg md:text-xl text-center max-w-xl mx-auto mt-4"
        }}
    >
      <div slot="background" class="w-full h-full">
        <Image
            src={CtaBg}
            alt="CTA Background"
            class="h-full w-full object-cover opacity-20"
        />
        <div class="absolute inset-0 bg-neutral-950/80" />
      </div>
    </RLASection>
  </main>
</AppLayout>
