---
import AppLayout from "#layouts/AppLayout.astro"
import { siteConfig } from "#config/site.config"
import { useI18n, getRelativeLocaleUrl, getLocale } from "@rimelight/i18n"
import { db } from "#db"
import { pages } from "#db/schema"
import { eq, and, isNull, desc } from "drizzle-orm"
import RLAPageSection from "@rimelight/ui/components/page-section/RLAPageSection.astro"
import RLALogo from "@rimelight/ui/components/logo/RLALogo.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import RLAGrid from "@rimelight/ui/components/grid/RLAGrid.astro"
import RLAPost from "@rimelight/ui/components/post/RLAPost.astro"

function getLocalizedText(val: unknown, locale: string): string {
  if (typeof val === "object" && val !== null) {
    const record = val as Record<string, string>
    return record[locale] || record.en || ""
  }
  return String(val || "")
}

const activeLocale = getLocale()
const blogPages = await db
  .select()
  .from(pages)
  .where(and(eq(pages.type, "blog"), isNull(pages.deletedAt)))
  .orderBy(desc(pages.postedAt))
  .catch(() => [])

const latestPosts = blogPages.slice(0, 3)

const messages = useI18n("playground")

const heroLinks = [
  {
    label: messages.heroLink,
    href: getRelativeLocaleUrl("/blog"),
    color: "primary",
    variant: "solid"
  }
]

const ctaLinks = [
  {
    label: messages.ctaStart,
    href: getRelativeLocaleUrl("/blog"),
    color: "primary",
    variant: "solid"
  },
  {
    label: messages.ctaContribute,
    href: getRelativeLocaleUrl("/"),
    color: "primary",
    variant: "outline",
    trailingIcon: "i-lucide-arrow-right"
  }
]
---

<AppLayout title={siteConfig.name} description={siteConfig.description}>
  <RLAPageSection
    variant="hero"
    reverse={true}
    title={messages.heroTitle}
    description={messages.heroDesc}
    links={heroLinks}
  >
    <RLALogo class="pointer-events-none h-64 w-auto" variant="logomark" />
  </RLAPageSection>

  <RLAPageSection
    orientation="vertical"
    title={messages.postsTitle}
    description={messages.postsDesc}
  >
    <div slot="body" class="flex flex-col gap-xl">
      <RLAGrid>
        {
          latestPosts.map((post) => {
            const content = typeof post.content === "string" ? JSON.parse(post.content) : post.content || {}
            const title = getLocalizedText(post.title, activeLocale)
            const description = content.properties?.description || ""
            const heroImage = content.properties?.heroImage
            const postDate = post.postedAt || post.createdAt
            return (
              <RLAPost
                variant="ghost"
                image={heroImage}
                date={postDate}
                title={title}
                description={description}
                to={getRelativeLocaleUrl(`/blog/${post.slug}/`)}
              />
            )
          })
        }
      </RLAGrid>

      {latestPosts.length > 0 && (
        <RLAButton
          label={messages.viewAllPosts}
          href={getRelativeLocaleUrl("/blog")}
          color="primary"
          variant="link"
          trailingIcon="i-lucide-arrow-right"
        />
      )}
    </div>
  </RLAPageSection>

  <RLAPageSection
    variant="cta"
    ctaVariant="solid"
    title={messages.ctaTitle}
    description={messages.ctaDesc}
    links={ctaLinks}
  />
</AppLayout>
