---
import AppLayout from "@/layouts/AppLayout.astro";
import { siteConfig } from "@/site.config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import { getCollection } from "astro:content";
import RLAPageSection from "@rimelight/ui/components/astro/RLAPageSection.astro";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import RLAGrid from "@rimelight/ui/components/astro/RLAGrid.astro";
import RLAPost from "@rimelight/ui/components/astro/RLAPost.astro";

const activeLocale = Astro.currentLocale ?? "en";
currentLocale.set(activeLocale);

const messages = useI18n("playground", {
    heroTitle: "Welcome to the Rimelight Entertainment",
    heroDesc: "Look around, test, and play with some of our interactive technologies.",
    heroLink: "Explore Now",
    postsTitle: "Latest Posts",
    postsDesc: "Read the latest updates to our projects.",
    viewAllPosts: "View All Posts",
    ctaTitle: "Wish to join us?",
    ctaDesc: "Explore our latest projects and get in touch.",
    ctaStart: "Get Started",
    ctaContribute: "Join Us",
});

const latestPosts = (await getCollection("blog"))
  .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const heroLinks = [
    {
        label: messages.heroLink,
        href: getRelativeLocaleUrl(activeLocale, "/blog"),
        color: "primary",
        variant: "solid",
    }
];

const ctaLinks = [
    {
        label: messages.ctaStart,
        href: getRelativeLocaleUrl(activeLocale, "/blog"),
        color: "primary",
        variant: "solid"
    },
    {
        label: messages.ctaContribute,
        href: getRelativeLocaleUrl(activeLocale, "/"),
        color: "primary",
        variant: "outline",
        trailingIcon: "i-lucide-arrow-right"
    }
];
---

<AppLayout title={siteConfig.name} description={siteConfig.description}>
    <RLAPageSection
            variant="hero"
            reverse={true}
            title={messages.heroTitle}
            description={messages.heroDesc}
            links={heroLinks}
    >
        <RLALogo class="pointer-events-none h-64 w-auto" variant="logomark" />
    </RLAPageSection>

    <RLAPageSection
            orientation="vertical"
            title={messages.postsTitle}
            description={messages.postsDesc}
    >
        <div slot="body" class="flex flex-col gap-xl">
            <RLAGrid>
                {
                    latestPosts.map((post) => (
                        <RLAPost
                            variant="ghost"
                            image={post.data.heroImage}
                            date={post.data.pubDate}
                            title={post.data.title}
                            description={post.data.description}
                            to={getRelativeLocaleUrl(activeLocale, `/blog/${post.id}/`)}
                        />
                    ))
                }
            </RLAGrid>

            {latestPosts.length > 0 && (
                    <RLAButton
                            label={messages.viewAllPosts}
                            href={getRelativeLocaleUrl(activeLocale, "/blog")}
                            color="primary"
                            variant="link"
                            trailingIcon="i-lucide-arrow-right"
                    />
            )}
        </div>
    </RLAPageSection>

    <RLAPageSection
            variant="cta"
            ctaVariant="solid"
            title={messages.ctaTitle}
            description={messages.ctaDesc}
            links={ctaLinks}
    />
</AppLayout>
