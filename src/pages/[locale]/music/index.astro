---
import AppLayout from "@/layouts/AppLayout.astro";
import RLAPageSection from "@rimelight/ui/components/page-section/RLAPageSection.astro";
import RLACard from "@rimelight/ui/components/card/RLACard.astro";
import { useI18n } from "@rimelight/i18n";

const messages = useI18n(Astro, "page_music", {
  title: "Music",
  description: "DJ mixes, curated playlists, and musical productions.",
  hero_title: "Music & Audio",
  hero_description: "Listen to DJ sets, original productions, and curated Spotify playlists.",
  section_mixes_title: "Featured Mixes & Sets",
  section_playlists_title: "Curated Playlists"
});

const spotifyPlaylists = [
  {
    id: "29kSyAiwnDXM59KoGEUAN9",
    title: "Curated Mix 1"
  },
  {
    id: "1fK0wAI02tDpmpkZ53cTmF",
    title: "Curated Mix 2"
  },
  {
    id: "0b7hixI5M1VQwD47KYWABj",
    title: "Curated Mix 3"
  },
  {
    id: "271UvSiUmd238ZYkNi5U57",
    title: "Curated Mix 4"
  }
];
---

<AppLayout title={messages.title} description={messages.description}>
  <RLAPageSection
    variant="hero"
    title={messages.hero_title}
    description={messages.hero_description}
    orientation="horizontal"
  />

  <!-- Featured Audio Section -->
  <RLAPageSection
    title={messages.section_mixes_title}
    orientation="vertical"
  >
    <div slot="body" class="max-w-4xl mx-auto w-full">
      <RLACard class="p-6 md:p-8 flex flex-col md:flex-row items-center gap-6 bg-default border border-neutral-200 dark:border-neutral-800 rounded-2xl shadow-sm">
        <div class="relative w-36 h-36 shrink-0 rounded-xl overflow-hidden bg-primary-500/10 flex items-center justify-center border border-primary-500/20 shadow-inner">
          <span class="i-lucide-disc-3 text-5xl text-primary-500 animate-spin-slow"></span>
        </div>
        <div class="flex-1 flex flex-col gap-3 w-full">
          <div>
            <span class="text-xs uppercase tracking-wider font-semibold text-primary-500">Original Track / Mix</span>
            <h3 class="text-xl font-bold text-neutral-900 dark:text-neutral-100">Bishu - Ikari</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">Electronic / Bass production</p>
          </div>
          <audio
            controls
            preload="metadata"
            class="w-full h-10 rounded-lg outline-none"
            src="https://cdn.idantity.me/music/Bishu%20-%20ikari.mp3"
          >
            Your browser does not support the audio element.
          </audio>
        </div>
      </RLACard>
    </div>
  </RLAPageSection>

  <!-- Curated Playlists Section -->
  <RLAPageSection
    title={messages.section_playlists_title}
    orientation="vertical"
  >
    <div slot="body" class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-6xl mx-auto w-full">
      {spotifyPlaylists.map((playlist) => (
        <RLACard class="p-2 overflow-hidden rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-default shadow-sm hover:shadow-md transition-shadow">
          <iframe
            style="border-radius: 12px"
            src={`https://open.spotify.com/embed/playlist/${playlist.id}?utm_source=generator`}
            width="100%"
            height="352"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            class="w-full border-0"
          />
        </RLACard>
      ))}
    </div>
  </RLAPageSection>
</AppLayout>

<style>
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  .animate-spin-slow {
    animation: spin-slow 8s linear infinite;
  }
</style>
