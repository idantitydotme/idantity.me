---
import AppLayout from "#layouts/AppLayout.astro";
import RLAPageSection from "@rimelight/ui/components/page-section/RLAPageSection.astro";
import RLACard from "@rimelight/ui/components/card/RLACard.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import Turnstile from "#components/Turnstile.astro";
import { t } from "@rimelight/i18n";
---

<AppLayout title={t("page_contact.title")} description={t("page_contact.description")}>
  <RLAPageSection
    variant="hero"
    title={t("page_contact.hero_title")}
    description={t("page_contact.hero_description")}
    orientation="horizontal"
  />

  <RLAPageSection orientation="vertical">
    <div slot="body" class="grid grid-cols-1 lg:grid-cols-2 gap-xl max-w-6xl mx-auto w-full">
      <!-- Contact Form Card -->
      <RLACard class="p-6 md:p-8 flex flex-col justify-between">
        <div>
          <h2 class="text-2xl font-bold text-[var(--rl-text)] mb-6 flex items-center gap-2">
            <span class="i-lucide-mail size-6 text-primary-500"></span>
            {t("page_contact.contact_form_title")}
          </h2>

          <form id="contact-form" class="flex flex-col gap-4">
            <div class="flex flex-col gap-1">
              <label for="contact-name" class="text-sm font-medium text-[var(--rl-text-muted)]">{t("page_contact.contact_form_name_label")}</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                placeholder={t("page_contact.contact_form_placeholder_name")}
                class="w-full px-4 py-2.5 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-default text-neutral-900 dark:text-neutral-100 focus:outline-none focus:ring-2 focus:ring-primary-500 transition"
              />
            </div>

            <div class="flex flex-col gap-1">
              <label for="contact-email" class="text-sm font-medium text-[var(--rl-text-muted)]">{t("page_contact.contact_form_email_label")}</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                placeholder={t("page_contact.contact_form_placeholder_email")}
                class="w-full px-4 py-2.5 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-default text-neutral-900 dark:text-neutral-100 focus:outline-none focus:ring-2 focus:ring-primary-500 transition"
              />
            </div>

            <div class="flex flex-col gap-1">
              <label for="contact-subject" class="text-sm font-medium text-[var(--rl-text-muted)]">{t("page_contact.contact_form_subject_label")}</label>
              <input
                id="contact-subject"
                name="subject"
                type="text"
                placeholder={t("page_contact.contact_form_placeholder_subject")}
                class="w-full px-4 py-2.5 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-default text-neutral-900 dark:text-neutral-100 focus:outline-none focus:ring-2 focus:ring-primary-500 transition"
              />
            </div>

            <div class="flex flex-col gap-1">
              <label for="contact-message" class="text-sm font-medium text-[var(--rl-text-muted)]">{t("page_contact.contact_form_message_label")}</label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                required
                placeholder={t("page_contact.contact_form_placeholder_message")}
                class="w-full px-4 py-2.5 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-default text-neutral-900 dark:text-neutral-100 focus:outline-none focus:ring-2 focus:ring-primary-500 transition resize-y min-h-[120px]"
              ></textarea>
            </div>

            <Turnstile />

            <RLAButton
              type="submit"
              color="primary"
              variant="solid"
              block={true}
              leadingIcon="i-lucide-send"
              label={t("page_contact.contact_form_send_button")}
              class="mt-2"
            />

            <p id="contact-status" class="text-sm min-h-[1.5rem] mt-2 font-medium" role="status"></p>
          </form>
        </div>
      </RLACard>

      <!-- File Upload Card -->
      <RLACard class="p-6 md:p-8 flex flex-col justify-between">
        <div>
          <h2 class="text-2xl font-bold text-[var(--rl-text)] mb-2 flex items-center gap-2">
            <span class="i-lucide-upload-cloud size-6 text-primary-500"></span>
            {t("page_contact.upload_form_title")}
          </h2>
          <p class="text-sm text-[var(--rl-text-muted)] mb-6">
            {t("page_contact.upload_form_description")}
          </p>

          <form id="upload-form" class="flex flex-col gap-4">
            <div class="flex flex-col gap-1">
              <label for="upload-file" class="text-sm font-medium text-[var(--rl-text-muted)]">{t("page_contact.upload_form_file_label")}</label>
              <input
                id="upload-file"
                name="file"
                type="file"
                accept="image/png,image/jpeg,image/webp,application/pdf"
                required
                class="w-full px-4 py-3 rounded-lg border border-neutral-300 dark:border-neutral-700 bg-default text-neutral-900 dark:text-neutral-100 focus:outline-none focus:ring-2 focus:ring-primary-500 transition file:mr-4 file:py-1.5 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary-500 file:text-white hover:file:bg-primary-600 cursor-pointer"
              />
            </div>

            <RLAButton
              type="submit"
              color="primary"
              variant="outline"
              block={true}
              leadingIcon="i-lucide-upload"
              label={t("page_contact.upload_form_upload_button")}
              class="mt-4"
            />

            <p id="upload-status" class="text-sm min-h-[1.5rem] mt-2 font-medium" role="status"></p>
          </form>
        </div>
      </RLACard>
    </div>
  </RLAPageSection>

  <script>
    import { api } from "#api/client";

    const contactForm = document.getElementById("contact-form") as HTMLFormElement | null;
    const contactStatus = document.getElementById("contact-status") as HTMLParagraphElement | null;

    if (contactForm && contactStatus) {
      contactForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        contactStatus.textContent = "Sending message...";
        contactStatus.className = "text-sm min-h-[1.5rem] mt-2 font-medium text-neutral-500";

        try {
          const res = await api.contact.$post({
            form: new FormData(contactForm) as any
          });
          const result = await res.json();

          if (!res.ok || !result.success) {
            const errorMsg = (!result.success && "error" in result) ? result.error : "Please check form fields and try again.";
            contactStatus.textContent = errorMsg || "Please check form fields and try again.";
            contactStatus.className = "text-sm min-h-[1.5rem] mt-2 font-medium text-red-500";
            return;
          }

          contactStatus.textContent = "Message sent successfully! ✅";
          contactStatus.className = "text-sm min-h-[1.5rem] mt-2 font-medium text-green-600 dark:text-green-400";
          contactForm.reset();
          // @ts-ignore
          window.turnstile?.reset?.();
        } catch (err) {
          contactStatus.textContent = "Failed to send message. Please try again.";
          contactStatus.className = "text-sm min-h-[1.5rem] mt-2 font-medium text-red-500";
        }
      });
    }

    const uploadForm = document.getElementById("upload-form") as HTMLFormElement | null;
    const uploadStatus = document.getElementById("upload-status") as HTMLParagraphElement | null;

    if (uploadForm && uploadStatus) {
      uploadForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        uploadStatus.textContent = "Uploading file...";
        uploadStatus.className = "text-sm min-h-[1.5rem] mt-2 font-medium text-neutral-500";

        try {
          const res = await api.upload.$post({
            form: new FormData(uploadForm) as any
          });
          const result = await res.json();

          if (!res.ok || !result.success) {
            const errorMsg = (!result.success && "error" in result) ? result.error : "Failed to upload file.";
            uploadStatus.textContent = errorMsg || "Failed to upload file.";
            uploadStatus.className = "text-sm min-h-[1.5rem] mt-2 font-medium text-red-500";
            return;
          }

          uploadStatus.textContent = `File uploaded! Key: ${result.key} ✅`;
          uploadStatus.className = "text-sm min-h-[1.5rem] mt-2 font-medium text-green-600 dark:text-green-400";
          uploadForm.reset();
        } catch (err) {
          uploadStatus.textContent = "Failed to upload file.";
          uploadStatus.className = "text-sm min-h-[1.5rem] mt-2 font-medium text-red-500";
        }
      });
    }
  </script>
</AppLayout>
