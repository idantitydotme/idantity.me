---
import AppLayout from '@/layouts/AppLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/site.config';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18nAsync, currentLocale } from "astro-nanostores-i18n:runtime";

const legalDocs = (await getCollection('legal')).toSorted(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const messages = await useI18nAsync("legal", {
    title: "Legal",
    heading: "Legal",
    lastUpdated: "Last updated:",
});
---

<AppLayout title={messages.title} description={siteConfig.description}>
		<section class="legal-section">
			<h1>{messages.heading}</h1>
			<ul class="legal-list">
				{legalDocs.map((doc) => (
					<li class="legal-item">
						<h3><a href={getRelativeLocaleUrl(activeLocale, `/legal/${doc.id}/`)}>{doc.data.title}</a></h3>
						<p>{doc.data.description}</p>
						<span class="date">{messages.lastUpdated} {doc.data.pubDate.toLocaleDateString()}</span>
					</li>
				))}
			</ul>
		</section>
</AppLayout>