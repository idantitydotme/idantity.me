---
import AppLayout from '@/layouts/AppLayout.astro';
import { useI18n, getRelativeLocaleUrl } from "@rimelight/i18n";


interface Props {
    error: unknown;
}

const { error } = Astro.props;


const messages = useI18n(Astro, 'errors', {
  notFound: 'Page Not Found',
  notFoundDesc: 'The page you are looking for does not exist.',
  serverError: 'Server Error',
  unknownError: 'Unknown error',
  goHome: 'Go Home'
});
---

<AppLayout title={messages.serverError} description={messages.serverError}>
  <div class="error-container">
    <p class="error-code">500</p>
    <h1 class="error-title">{messages.serverError}</h1>
    <p class="error-desc">{error instanceof Error ? error.message : messages.unknownError}</p>
    <a href={getRelativeLocaleUrl('/')} class="error-link">{messages.goHome}</a>
  </div>
</AppLayout>
