---
import ConstructionLayout from '@/layouts/ConstructionLayout.astro'
import RLALogo from '@rimelight/ui/components/astro/RLALogo.astro'
import RLALocaleSelector from "@rimelight/ui/components/astro/RLALocaleSelector.astro";
import ConstructionSignIn from '@/components/auth/ConstructionSignIn.vue'
import { useI18n, currentLocale } from 'astro-nanostores-i18n:runtime'

const activeLocale = Astro.currentLocale ?? 'en'
currentLocale.set(activeLocale)

const messages = useI18n('construction', {
  constructionTitle: 'Under Construction',
  constructionHeading: 'THIS WEBSITE IS CURRENTLY IN CONSTRUCTION',
  constructionDescription: 'Please sign in if you have access.',
  constructionSignIn: 'Sign In',
})

const targetLanguages = [
  { code: 'en', label: 'English' },
  { code: 'es', label: 'Español' },
  { code: 'pt', label: 'Português' },
]
---

<ConstructionLayout title={messages.constructionTitle} description={messages.constructionDescription}>
  <div class="flex min-h-screen flex-col items-center justify-center bg-black px-4 py-12">
    <div class="z-10 w-full max-w-md space-y-8 text-center">
      <div class="flex flex-col items-center gap-4">
        <RLALogo class="h-12 w-auto text-white" variant="logomark" mode="white" />
        <h1 class="m-0 text-3xl font-bold text-white sm:text-4xl">
          {messages.constructionHeading}
        </h1>
        <p class="m-0 text-neutral-400">{messages.constructionDescription}</p>
      </div>

      <ConstructionSignIn client:load />

      <div class="flex flex-col items-center gap-2 text-xs text-neutral-500">
        <span>&copy; {new Date().getFullYear()} Rimelight Entertainment</span>
        <RLALocaleSelector locales={targetLanguages} />
      </div>
    </div>
  </div>
</ConstructionLayout>
