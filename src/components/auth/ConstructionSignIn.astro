---
import RLACard from "@rimelight/ui/components/card/RLACard.astro"
import RLAFormField from "@rimelight/ui/components/form-field/RLAFormField.astro"
import RLAInput from "@rimelight/ui/components/input/RLAInput.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import RLACheckbox from "@rimelight/ui/components/checkbox/RLACheckbox.astro"

interface Props {
  allowAuth?: boolean
  passphraseLabel?: string
  passphrasePlaceholder?: string
  rememberMeLabel?: string
  signInButtonLabel?: string
}

const {
  allowAuth = true,
  passphraseLabel = "Passphrase",
  passphrasePlaceholder = "Enter passphrase...",
  rememberMeLabel = "Remember me",
  signInButtonLabel = "Sign In"
} = Astro.props
---

{allowAuth ? (
  <RLACard class="bg-black text-left">
    <form id="sign-in-form" class="flex flex-col gap-4">
      <p id="error-message" class="text-red-500 text-sm hidden"></p>

      <div class="flex flex-col gap-4">
        <RLAFormField
          label={passphraseLabel}
          required
          ui={{
            label: 'text-white',
            description: 'text-neutral-500'
          }}
        >
          <RLAInput
            id="passphrase-input"
            type="password"
            name="passphrase"
            placeholder={passphrasePlaceholder}
            class="w-full text-white"
            required
          />
        </RLAFormField>

        <RLACheckbox
          id="remember-me-checkbox"
          name="rememberMe"
          label={rememberMeLabel}
          checked
          ui={{
            label: 'text-white',
            indicator: 'data-[state=checked]:bg-primary-500 data-[state=checked]:text-white'
          }}
        />

        <RLAButton
          id="submit-button"
          type="submit"
          color="primary"
          variant="solid"
          block
          class="text-white bg-primary-500 hover:bg-primary-600 w-full"
          data-label={signInButtonLabel}
        >
          {signInButtonLabel}
        </RLAButton>
      </div>
    </form>
  </RLACard>
) : (
  <p class="text-neutral-400">Please return at a later stage.</p>
)}

<script>
  function getRedirectParam() {
    const params = new URLSearchParams(window.location.search)
    return params.get("redirect") || "/"
  }

  const form = document.getElementById("sign-in-form")
  const passphraseInput = document.getElementById("passphrase-input") as HTMLInputElement | null
  const rememberCheckbox = document.getElementById("remember-me-checkbox") as HTMLInputElement | null
  const errorMessage = document.getElementById("error-message")
  const submitButton = document.getElementById("submit-button")

  if (form) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault()
      if (!passphraseInput || !submitButton || !errorMessage) return

      // Set loading state
      submitButton.setAttribute("disabled", "true")
      submitButton.textContent = "Signing In..."
      errorMessage.classList.add("hidden")
      errorMessage.textContent = ""

      try {
        const response = await fetch("/api/construction-guest", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            passphrase: passphraseInput.value,
            rememberMe: rememberCheckbox ? rememberCheckbox.checked : true
          })
        })
        const errorBody = response.ok ? null : await response.json() as { error?: string }
        const signInError = response.ok ? null : { message: errorBody?.error }

        if (signInError) {
          errorMessage.textContent = signInError.message || "Something went wrong"
          errorMessage.classList.remove("hidden")
          submitButton.removeAttribute("disabled")
          submitButton.textContent = submitButton.getAttribute("data-label") || "Sign In"
          return
        }

        window.location.href = getRedirectParam()
      } catch (err: any) {
        errorMessage.textContent = err?.message || "An unexpected error occurred."
        errorMessage.classList.remove("hidden")
        submitButton.removeAttribute("disabled")
        submitButton.textContent = submitButton.getAttribute("data-label") || "Sign In"
      }
    })
  }
</script>
