---
import RLAInput from "@rimelight/ui/components/input/RLAInput.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import RLACheckbox from "@rimelight/ui/components/checkbox/RLACheckbox.astro"
import RLAIcon from "@rimelight/ui/components/icon/RLAIcon.astro"

interface Props {
  recovery?: boolean
  terms?: boolean
  remember?: boolean
  messages?: Record<string, string>
}

const {
  recovery = true,
  terms = true,
  remember = true,
  messages = {}
} = Astro.props as Props
---

<div class="w-full flex flex-col gap-lg max-w-md" id="auth-sign-in-form-root">
  <p id="auth-sign-in-error" class="hidden text-sm text-error-500"></p>

  <form id="auth-sign-in-form" method="POST" action="javascript:void(0)" class="flex flex-col gap-md text-left">
    <div class="flex flex-col gap-1 text-neutral-900 dark:text-neutral-100">
      <label class="text-sm font-medium">{messages.auth_email_label ?? "E-mail"}</label>
      <RLAInput
        type="email"
        name="email"
        id="sign-in-email"
        placeholder={messages.auth_email_placeholder ?? "your@email.com"}
        required
        class="w-full"
      />
      {recovery && (
        <a href="/auth/recovery" class="text-xs text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200 mt-1">
          {messages["auth_sign-in_email_help"] ?? "Recover email"}
        </a>
      )}
    </div>

    <div class="flex flex-col gap-1 text-neutral-900 dark:text-neutral-100">
      <label class="text-sm font-medium">{messages.auth_password_label ?? "Password"}</label>
      <div class="relative w-full flex items-center">
        <RLAInput
          type="password"
          name="password"
          id="sign-in-password"
          placeholder="••••••••••••••••"
          required
          class="w-full pr-10"
        />
        <button
          type="button"
          id="toggle-password-btn"
          class="absolute right-2 p-1 text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200 focus:outline-none flex items-center justify-center"
          aria-label="Toggle password visibility"
        >
          <RLAIcon name="eye" id="toggle-password-icon" size="sm" />
        </button>
      </div>
      {recovery && (
        <a href="/auth/recovery" class="text-xs text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200 mt-1">
          {messages["auth_sign-in_password_help"] ?? "Forgot password?"}
        </a>
      )}
    </div>

    {remember && (
      <RLACheckbox
        name="rememberMe"
        id="sign-in-remember"
        label={messages.auth_remember_me ?? "Remember me"}
      />
    )}

    <RLAButton
      color="primary"
      variant="solid"
      type="submit"
      block
      id="sign-in-submit-btn"
    >
      {messages.auth_sign_in_button ?? "Sign in"}
    </RLAButton>
  </form>

  {terms && (
    <span class="text-center text-sm text-neutral-700 dark:text-neutral-300">
      {messages.auth_terms_agreement ?? "By signing in you agree to our"}{" "}
      <a href="/documents/terms-of-service" class="font-medium text-primary-600 dark:text-primary-400 hover:underline">
        {messages.auth_terms_link ?? "Terms of Service"}
      </a>.
    </span>
  )}
</div>

<script>
  import { authClient } from "@/auth/auth-client"

  function initSignInForm() {
    const form = document.getElementById("auth-sign-in-form") as HTMLFormElement | null
    const errorEl = document.getElementById("auth-sign-in-error")
    const submitBtn = document.getElementById("sign-in-submit-btn") as HTMLButtonElement | null
    const toggleBtn = document.getElementById("toggle-password-btn")
    const passwordInput = document.getElementById("sign-in-password") as HTMLInputElement | null

    if (toggleBtn && passwordInput) {
      toggleBtn.replaceWith(toggleBtn.cloneNode(true))
      const newToggleBtn = document.getElementById("toggle-password-btn")
      newToggleBtn?.addEventListener("click", (e) => {
        e.preventDefault()
        const isPassword = passwordInput.type === "password"
        passwordInput.type = isPassword ? "text" : "password"
        
        const svgIcon = newToggleBtn.querySelector("svg")
        if (svgIcon) {
          if (isPassword) {
            svgIcon.innerHTML = `<path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499A10.75 10.75 0 0 1 2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.225-4.22"/><line x1="2" x2="22" y1="2" y2="22"/>`
          } else {
            svgIcon.innerHTML = `<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0z"/><circle cx="12" cy="12" r="3"/>`
          }
        }
      })
    }

    if (form && !form.dataset.initialized) {
      form.dataset.initialized = "true"
      form.addEventListener("submit", async (e) => {
        e.preventDefault()
        e.stopPropagation()

        if (errorEl) { errorEl.classList.add("hidden"); errorEl.textContent = "" }

        const emailInput = document.getElementById("sign-in-email") as HTMLInputElement | null
        const rememberInput = document.getElementById("sign-in-remember") as HTMLInputElement | null

        const email = emailInput?.value || ""
        const password = passwordInput?.value || ""
        const rememberMe = rememberInput ? rememberInput.checked : true

        let origBtnContent = ""
        if (submitBtn) {
          submitBtn.disabled = true
          origBtnContent = submitBtn.innerHTML
          submitBtn.innerHTML = `<span class="flex items-center justify-center gap-2"><svg class="animate-spin size-4 text-current" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg><span>Signing in...</span></span>`
        }

        try {
          const { error } = await authClient.signIn.email({
            email,
            password,
            rememberMe
          })

          if (error) {
            if (errorEl) {
              errorEl.textContent = error.message || "Failed to sign in"
              errorEl.classList.remove("hidden")
            }
            if (submitBtn) {
              submitBtn.disabled = false
              submitBtn.innerHTML = origBtnContent
            }
            return
          }

          const params = new URLSearchParams(window.location.search)
          const redirect = params.get("redirect") || "/"
          const targetUrl = new URL(redirect, window.location.origin)
          targetUrl.searchParams.set("signed_in", "1")
          window.location.href = targetUrl.toString()
        } catch (err: any) {
          if (errorEl) {
            errorEl.textContent = err?.message || "An unexpected error occurred"
            errorEl.classList.remove("hidden")
          }
          if (submitBtn) {
            submitBtn.disabled = false
            submitBtn.innerHTML = origBtnContent
          }
        }
      })
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSignInForm)
  } else {
    initSignInForm()
  }
  document.addEventListener("astro:page-load", initSignInForm)
</script>
