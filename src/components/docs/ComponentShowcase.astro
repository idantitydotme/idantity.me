---
interface Props {
  component?: string;
  slots?: string[];
  props?: Record<string, any>;
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`component-showcase border border-border rounded-xl overflow-hidden bg-background text-foreground ${className}`}>
  <div class="preview-area p-4 sm:p-6 flex items-center justify-center min-h-[120px] border-b border-border relative group">
    <div class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
        <div class="text-xs bg-muted text-muted-foreground px-2 py-1 rounded border border-border">Preview</div>
    </div>
    <slot />
  </div>

  <div class="controls-area px-4 py-2 bg-muted/30 border-b border-border flex items-center justify-between gap-4">
    <div class="flex items-center gap-2">
       <button class="showcase-tab active px-3 py-1 text-xs font-medium rounded-md bg-background text-foreground shadow-sm border border-border" data-lang="astro">Astro</button>
       <button class="showcase-tab px-3 py-1 text-xs font-medium rounded-md text-muted-foreground hover:text-foreground hover:bg-accent/50 transition-colors" data-lang="vue">Vue</button>
    </div>

    <div class="flex items-center gap-2">
         <button class="copy-code p-1.5 rounded-md text-muted-foreground hover:text-foreground hover:bg-accent/50 transition-colors" title="Copy code">
            <span class="i-lucide-copy size-4"></span>
         </button>
    </div>
  </div>

  <div class="code-area bg-gray-950">
    <div class="code-block" data-lang="astro">
        <slot name="code-astro" />
    </div>
    <div class="code-block hidden" data-lang="vue">
        <slot name="code-vue" />
    </div>
  </div>
</div>

<style>
  .showcase-tab.active {
    color: var(--color-primary-500);
  }

  .code-area pre {
    background-color: transparent !important;
    margin: 0 !important;
    padding: 1rem !important;
    border-radius: 0 !important;
    border-width: 0 !important;
  }
</style>

<script>
  function initShowcases() {
    document.querySelectorAll('.component-showcase').forEach(showcase => {
      const tabs = showcase.querySelectorAll('.showcase-tab');
      const codeBlocks = showcase.querySelectorAll('.code-block');
      const copyBtn = showcase.querySelector('.copy-code');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const lang = tab.getAttribute('data-lang');

          tabs.forEach(t => {
            t.classList.remove('active', 'bg-background', 'text-foreground', 'shadow-sm', 'border', 'border-border');
            t.classList.add('text-muted-foreground');
          });

          tab.classList.add('active', 'bg-background', 'text-foreground', 'shadow-sm', 'border', 'border-border');
          tab.classList.remove('text-muted-foreground');

          codeBlocks.forEach(block => {
            if (block.getAttribute('data-lang') === lang) {
              block.classList.remove('hidden');
            } else {
              block.classList.add('hidden');
            }
          });
        });
      });

      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const visibleCode = showcase.querySelector('.code-block:not(.hidden) pre');
          if (visibleCode) {
            navigator.clipboard.writeText(visibleCode.textContent || '');
            const icon = copyBtn.querySelector('span');
            if (icon) {
              icon.className = 'i-lucide-check size-4 text-green-500';
              setTimeout(() => {
                icon.className = 'i-lucide-copy size-4';
              }, 2000);
            }
          }
        });
      }
    });
  }

  document.addEventListener('astro:page-load', initShowcases);
  initShowcases();
</script>
