---
interface Props {
  copy?: boolean;
  share?: boolean;
}

const { copy = true, share = true } = Astro.props;
---

{(copy || share) && (
  <div class="rl-addons flex gap-2 items-center justify-end my-4">
    {copy && (
      <button class="rl-addon-btn" id="rl-copy-markdown" title="Copy Markdown">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        <span class="text-xs ml-1.5 font-medium">Copy Markdown</span>
      </button>
    )}
    {share && (
      <button class="rl-addon-btn" id="rl-share" title="Share">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
        <span class="text-xs ml-1.5 font-medium">Share</span>
      </button>
    )}
  </div>
)}

<style>
  .rl-addon-btn {
    background-color: var(--base-100, #f3f4f6);
    color: var(--foreground, #1f2937);
    border: 1px solid var(--base-200, #e5e7eb);
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .rl-addon-btn:hover {
    background-color: var(--base-200, #e5e7eb);
  }

  .rl-addon-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
  
  :global(.dark) .rl-addon-btn {
    background-color: #1f2937;
    color: #f3f4f6;
    border-color: #374151;
  }
  
  :global(.dark) .rl-addon-btn:hover {
    background-color: #374151;
  }
</style>

<script>
  import TurndownService from "turndown";
  import { gfm } from "turndown-plugin-gfm";

  const turndown = new TurndownService({
    headingStyle: "atx",
    codeBlockStyle: "fenced",
    bulletListMarker: "-",
  });
  turndown.use(gfm);

  function setupAddons() {
    const copyBtn = document.getElementById("rl-copy-markdown") as HTMLButtonElement | null;
    const shareBtn = document.getElementById("rl-share");

    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        try {
          copyBtn.disabled = true;
          const contentEl = document.querySelector(".markdown-content");
          if (!contentEl) {
            throw new Error("Content not found");
          }
          const clone = contentEl.cloneNode(true) as Element;
          clone.querySelectorAll("script, style, noscript, .sl-anchor-link, [data-pagefind-ignore]").forEach((el: Element) => el.remove());
          const markdown = turndown.turndown(clone as HTMLElement);
          await navigator.clipboard.writeText(markdown);
          
          const origText = copyBtn.querySelector('span')!.textContent;
          copyBtn.querySelector('span')!.textContent = "Copied!";
          setTimeout(() => {
            copyBtn.querySelector('span')!.textContent = origText;
          }, 2000);
        } catch (err) {
          console.error("Failed to copy:", err);
        } finally {
          copyBtn.disabled = false;
        }
      });
    }

    const typedShareBtn = shareBtn as HTMLButtonElement | null;
    if (typedShareBtn) {
      typedShareBtn.addEventListener("click", async () => {
        if (navigator.share) {
          try {
            await navigator.share({ title: document.title, url: window.location.href });
          } catch (err) {
            const error = err as { name?: string };
            if (error.name !== "AbortError") {
              console.error("Share failed:", err);
            }
          }
        } else {
          try {
            await navigator.clipboard.writeText(window.location.href);
            const origText = typedShareBtn.querySelector('span')!.textContent;
            typedShareBtn.querySelector('span')!.textContent = "Link Copied!";
            setTimeout(() => {
              typedShareBtn.querySelector('span')!.textContent = origText;
            }, 2000);
          } catch (err) {
            console.error("Failed to copy link:", err);
          }
        }
      });
    }
  }

  // runs on initial page load
  setupAddons();

  // runs on view transitions navigation
  document.addEventListener("astro:after-swap", setupAddons);
</script>
