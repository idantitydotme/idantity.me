---
import RLAHeader from "@rimelight/ui/components/astro/RLAHeader.astro";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";
import { NavigationMenu } from "@rimelight/ui/nuxt"
import type { NavigationMenuItem } from "@rimelight/ui/types"
import { getRelativeLocaleUrl } from "astro:i18n";
import { useI18n } from "astro-nanostores-i18n:runtime";

const activeLocale = Astro.currentLocale ?? "en";

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const messages = useI18n("app_header", {
	"links_projects_label": "me.projects",
	"links_music_label": "me.music",
	"links_blog_label": "me.blog",
	"links_about_label": "me.about",
	"links_services_label": "me.services",
	"links_resume_label": "me.resume"
});

const leftItems: NavigationMenuItem[] = [
  {
    label: messages["links_projects_label"],
    to: getRelativeLocaleUrl(activeLocale, '/projects'),
    active: pathname === getRelativeLocaleUrl(activeLocale, '/projects').replace(/\/+$/, '')
  },
  {
    label: messages["links_music_label"],
    to: getRelativeLocaleUrl(activeLocale, '/music'),
    active: pathname.startsWith(getRelativeLocaleUrl(activeLocale, '/music').replace(/\/+$/, ''))
  },
  {
    label: messages["links_blog_label"],
    to: getRelativeLocaleUrl(activeLocale, '/blog'),
    active: pathname.startsWith(getRelativeLocaleUrl(activeLocale, '/blog').replace(/\/+$/, ''))
  },
	{
		label: messages["links_about_label"],
		to: getRelativeLocaleUrl(activeLocale, '/about'),
		active: pathname.startsWith(getRelativeLocaleUrl(activeLocale, '/about').replace(/\/+$/, ''))
	}
];

const rightItems: NavigationMenuItem[] = [
{
	label: messages["links_services_label"],
		to: getRelativeLocaleUrl(activeLocale, '/services'),
	active: pathname.startsWith(getRelativeLocaleUrl(activeLocale, '/services').replace(/\/+$/, ''))
},
{
	label: messages["links_resume_label"],
		to: getRelativeLocaleUrl(activeLocale, '/resume'),
	active: pathname.startsWith(getRelativeLocaleUrl(activeLocale, '/resume').replace(/\/+$/, ''))
}
]
---

<RLAHeader fixed={true} stackIndex={0} class="bg-black">
	<div slot="left" class="flex flex-row items-center gap-md">
		<RLALogo variant="logomark" class="h-10 w-auto" />
		<NavigationMenu
			client:load
			items={leftItems}
			variant="link"
			ui={{
				link: [
					'text-white transition-colors duration-200',
					'hover:text-primary-400',
					'data-[state=open]:text-primary-400',
					'aria-[current]:text-primary-400'
				]
			}}
		/>
	</div>
	<div slot="right" class="flex flex-row items-center gap-md">
		<NavigationMenu
			client:load
			items={rightItems}
			variant="link"
			ui={{
				link: [
					'text-white transition-colors duration-200',
					'hover:text-primary-400',
					'data-[state=open]:text-primary-400',
					'aria-[current]:text-primary-400'
				]
			}}
		/>
	</div>
</RLAHeader>
