---
import RLAHeader from "@rimelight/ui/components/astro/RLAHeader.astro";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";
import type { NavigationMenuItem } from "@rimelight/ui/nuxt/types"
import { NavigationMenu } from "@rimelight/ui/nuxt"
import { getRelativeLocaleUrl } from "astro:i18n";

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const items: NavigationMenuItem[] = [
  {
    label: 'Home',
    to: getRelativeLocaleUrl(Astro.currentLocale ?? 'en', '/'),
    active: pathname === getRelativeLocaleUrl(Astro.currentLocale ?? 'en', '/').replace(/\/+$/, '')
  },
  {
    label: 'Blog',
    to: getRelativeLocaleUrl(Astro.currentLocale ?? 'en', '/blog'),
    active: pathname.startsWith(getRelativeLocaleUrl(Astro.currentLocale ?? 'en', '/blog').replace(/\/+$/, ''))
  },
  {
    label: 'Docs',
    to: getRelativeLocaleUrl(Astro.currentLocale ?? 'en', '/docs'),
    active: pathname.startsWith(getRelativeLocaleUrl(Astro.currentLocale ?? 'en', '/docs').replace(/\/+$/, ''))
  },
  {
    label: 'About',
    to: getRelativeLocaleUrl(Astro.currentLocale ?? 'en', '/about'),
    active: pathname.startsWith(getRelativeLocaleUrl(Astro.currentLocale ?? 'en', '/about').replace(/\/+$/, ''))
  },
  {
    label: 'Legal',
    to: getRelativeLocaleUrl(Astro.currentLocale ?? 'en', '/legal'),
    active: pathname.startsWith(getRelativeLocaleUrl(Astro.currentLocale ?? 'en', '/legal').replace(/\/+$/, ''))
  }
];
---

<RLAHeader fixed={true} stackIndex={0} class="bg-black">
	<div slot="left" class="flex flex-row items-center gap-md">
		<RLALogo variant="logomark" class="h-10 w-auto" />
		<NavigationMenu
			client:load
			items={items}
			variant="link"
			ui={{
				link: [
					'text-white transition-colors duration-200',
					'hover:text-primary-400',
					'data-[state=open]:text-primary-400',
					'aria-[current]:text-primary-400'
				]
			}}
		/>
	</div>
</RLAHeader>
