---
import RLAHeader from "@rimelight/ui/components/header/RLAHeader.astro";
import RLALogo from "@rimelight/ui/components/logo/RLALogo.astro";
import RLANavigationMenu from "@rimelight/ui/components/navigation-menu/RLANavigationMenu.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import RLASlideover from "@rimelight/ui/components/slideover/RLASlideover.astro";
import type { NavigationMenuItem } from "@rimelight/ui/components/navigation-menu/navigation-menu.ts";
import type { ButtonProps } from "@rimelight/ui/components/button/button.ts";
import { useI18n, getRelativeLocaleUrl } from "@rimelight/i18n";

const activeLocale = Astro.currentLocale ?? "en";

const messages = useI18n(Astro, "app_header", {
	"left-links_projects_label": "me.projects",
	"left-links_music_label": "me.music",
	"left-links_blog_label": "me.blog",
	"left-links_about_label": "me.about",
	"right-links_services_label": "me.services",
	"right-links_resume_label": "me.resume",
  "socials_instagram_label": "Instagram",
  "socials_github_label": "GitHub"
});

const leftLinks: NavigationMenuItem[] = [
  {
    label: messages["left-links_projects_label"],
    to: getRelativeLocaleUrl(activeLocale, '/projects'),
  },
  {
    label: messages["left-links_music_label"],
    to: getRelativeLocaleUrl(activeLocale, '/music'),
  },
  {
    label: messages["left-links_blog_label"],
    to: getRelativeLocaleUrl(activeLocale, '/blog'),
  },
	{
		label: messages["left-links_about_label"],
		to: getRelativeLocaleUrl(activeLocale, '/about'),
	}
];

const rightLinks: NavigationMenuItem[] = [
  {
    label: messages["right-links_services_label"],
    to: getRelativeLocaleUrl(activeLocale, '/services'),
  },
  {
    label: messages["right-links_resume_label"],
    to: getRelativeLocaleUrl(activeLocale, '/resume'),
  }
];

const socials: ButtonProps[] = [
  {
    variant: "ghost",
    leadingIcon: "i-logos-instagram-icon?mask text-white group-hover:text-primary-500",
    href: "https://instagram.com/idantity.me"
  },
  {
    variant: "ghost",
    leadingIcon: "i-logos-github-icon?mask text-white group-hover:text-primary-500",
    href: "https://github.com/idantitydotme"
  }
];
---

<RLAHeader
  contain={false}
  fixed={true}
  class="bg-black"
>
  <div slot="left" class="flex items-center gap-md">
    <div class="hidden md:flex flex-row gap-md">
      <RLALogo
        variant="logomark"
        class="h-10 w-auto"
        mode="white"
      />
      <RLANavigationMenu
        items={leftLinks}
        variant="link"
        theme="flat"
        ui={{
          link: 'text-white transition-colors duration-200 hover:text-primary-400 data-[state=open]:text-primary-400 aria-[current]:text-primary-400'
        }}
      />
    </div>

    <div class="block md:hidden">
      <RLASlideover side="left" title="Menu">
        <RLAButton
          slot="trigger"
          color="neutral"
          variant="ghost"
          rounded={true}
          leadingIcon="i-lucide-menu"
          class="!text-white"
          theme="dark"
          aria-label="Open Menu"
        />

        <RLANavigationMenu
          items={leftLinks}
          orientation="vertical"
          variant="link"
          ui={{
            link: "text-black dark:text-white flex justify-start items-center w-full text-left py-2 text-lg transition-colors duration-200 hover:text-primary-400 data-[state=open]:text-primary-400 aria-[current]:text-primary-400"
          }}
        />
      </RLASlideover>
    </div>
  </div>

  <div slot="center" class="flex items-center gap-md">
    <div class="block md:hidden">
      <RLALogo
        variant="logomark"
        class="h-10 w-auto"
        mode="white"
      />
    </div>
  </div>

  <div slot="right" class="flex items-center gap-md">

    <div class="hidden md:flex flex-row gap-md">
      <RLANavigationMenu
        items={rightLinks}
        variant="link"
        theme="flat"
        ui={{
          link: 'text-white transition-colors duration-200 hover:text-primary-400 data-[state=open]:text-primary-400 aria-[current]:text-primary-400'
        }}
      />
      {socials.map((buttonProps) => (
        <RLAButton {...buttonProps} />
      ))}
    </div>

    <div class="block md:hidden">
      <RLASlideover side="right" title="Actions">
        <RLAButton
          slot="trigger"
          color="neutral"
          variant="ghost"
          rounded={true}
          leadingIcon="i-lucide-ellipsis-vertical"
          class="!text-white"
          theme="dark"
          aria-label="Open Actions"
        />

        <div class="flex flex-col gap-md">
          {socials.map((buttonProps) => (
            <RLAButton {...buttonProps} block={true} />
          ))}
        </div>
      </RLASlideover>
    </div>
	</div>
</RLAHeader>
