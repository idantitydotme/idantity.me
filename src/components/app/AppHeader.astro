---
import RLAHeader from "@rimelight/ui/components/header/RLAHeader.astro";
import RLALogo from "@rimelight/ui/components/logo/RLALogo.astro";
import RLANavigationMenu from "@rimelight/ui/components/navigation-menu/RLANavigationMenu.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import RLASlideover from "@rimelight/ui/components/slideover/RLASlideover.astro";
import type { NavigationMenuItem } from "@rimelight/ui/components/navigation-menu/navigation-menu.ts";
import type { ButtonProps } from "@rimelight/ui/components/button/button.ts";
import RLAAvatar from "@rimelight/ui/components/avatar/RLAAvatar.astro";
import RLAPopover from "@rimelight/ui/components/popover/RLAPopover.astro";
import { auth } from "@/auth";

let session: any = null;
try {
  session = await auth.api.getSession({ headers: Astro.request.headers });
} catch (e) {}

import { useI18n, getRelativeLocaleUrl } from "@rimelight/i18n";

const messages = useI18n("app_header");

const leftLinks: NavigationMenuItem[] = [
  {
    label: messages["left-links_projects_label"],
    to: getRelativeLocaleUrl('/projects'),
  },
  {
    label: messages["left-links_music_label"],
    to: getRelativeLocaleUrl('/music'),
  },
  {
    label: messages["left-links_blog_label"],
    to: getRelativeLocaleUrl('/blog'),
  },
	{
		label: messages["left-links_about_label"],
		to: getRelativeLocaleUrl('/about'),
	}
];

const rightLinks: NavigationMenuItem[] = [
  {
    label: messages["right-links_services_label"],
    to: getRelativeLocaleUrl('/services'),
  },
  {
    label: messages["right-links_resume_label"],
    to: getRelativeLocaleUrl('/resume'),
  }
];

const socials: ButtonProps[] = [
  {
    variant: "ghost",
    leadingIcon: "i-logos-instagram-icon?mask text-white group-hover:text-primary-500",
    href: "https://instagram.com/idantity.me"
  },
  {
    variant: "ghost",
    leadingIcon: "i-logos-github-icon?mask text-white group-hover:text-primary-500",
    href: "https://github.com/idantitydotme"
  }
];
---

<RLAHeader
  contain={false}
  fixed={true}
  class="bg-black"
>
  <div slot="left" class="flex items-center gap-md">
    <div class="hidden md:flex flex-row gap-md">
      <RLALogo
        variant="logomark"
        class="h-10 w-auto"
        mode="white"
      />
      <RLANavigationMenu
        items={leftLinks}
        variant="link"
        theme="flat"
        ui={{
          link: 'text-white transition-colors duration-200 hover:text-primary-400 data-[state=open]:text-primary-400 aria-[current]:text-primary-400'
        }}
      />
    </div>

    <div class="block md:hidden">
      <RLASlideover side="left" title="Menu">
        <RLAButton
          slot="trigger"
          color="neutral"
          variant="ghost"
          rounded={true}
          leadingIcon="i-lucide-menu"
          class="!text-white"
          theme="dark"
          aria-label="Open Menu"
        />

        <RLANavigationMenu
          items={leftLinks}
          orientation="vertical"
          variant="link"
          ui={{
            link: "text-black dark:text-white flex justify-start items-center w-full text-left py-2 text-lg transition-colors duration-200 hover:text-primary-400 data-[state=open]:text-primary-400 aria-[current]:text-primary-400"
          }}
        />
      </RLASlideover>
    </div>
  </div>

  <div slot="center" class="flex items-center gap-md">
    <div class="block md:hidden">
      <RLALogo
        variant="logomark"
        class="h-10 w-auto"
        mode="white"
      />
    </div>
  </div>

  <div slot="right" class="flex items-center gap-md">

    <div class="hidden md:flex flex-row gap-md items-center">
      <RLANavigationMenu
        items={rightLinks}
        variant="link"
        theme="flat"
        ui={{
          link: 'text-white transition-colors duration-200 hover:text-primary-400 data-[state=open]:text-primary-400 aria-[current]:text-primary-400'
        }}
      />
      {socials.map((buttonProps) => (
        <RLAButton {...buttonProps} />
      ))}

      {session && (
        <RLAPopover placement="bottom-end" class="relative group/popover ml-2">
          <div slot="trigger" class="flex items-center gap-xs cursor-pointer text-white hover:text-primary-400 transition-colors py-1 px-2 rounded-lg">
            <div class="relative">
              <RLAAvatar src={session.user.image} alt={session.user.name} size="sm" />
              <span class="absolute bottom-0 right-0 block h-2.5 w-2.5 rounded-full ring-2 ring-black bg-success-500" />
            </div>
            <span class="hidden md:inline text-sm font-medium">{session.user.name}</span>
          </div>

          <div class="flex flex-col gap-2 min-w-[240px] text-neutral-900 dark:text-neutral-100">
            <div class="flex items-center gap-sm pb-2 border-b border-neutral-200 dark:border-neutral-800">
              <RLAAvatar src={session.user.image} alt={session.user.name} size="md" />
              <div class="flex flex-col">
                <span class="font-semibold text-sm">{session.user.name}</span>
                <span class="text-xs text-neutral-500 truncate max-w-[150px]">{session.user.email}</span>
              </div>
            </div>

            <div class="flex flex-col">
              <RLAButton
                color="neutral"
                variant="ghost"
                block={true}
                class="!justify-start text-error-500 hover:text-error-600"
                href={getRelativeLocaleUrl('/auth/sign-out')}
                leadingIcon="i-lucide-log-out"
                label="Sign out"
              />
            </div>
          </div>
        </RLAPopover>
      )}
    </div>

    <div class="block md:hidden">
      <RLASlideover side="right" title="Actions">
        <RLAButton
          slot="trigger"
          color="neutral"
          variant="ghost"
          rounded={true}
          leadingIcon="i-lucide-ellipsis-vertical"
          class="!text-white"
          theme="dark"
          aria-label="Open Actions"
        />

        <div class="flex flex-col gap-md">
          {socials.map((buttonProps) => (
            <RLAButton {...buttonProps} block={true} />
          ))}
        </div>
      </RLASlideover>
    </div>
	</div>
</RLAHeader>
