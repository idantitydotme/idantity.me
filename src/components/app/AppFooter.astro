---
import RLAFooter from "@rimelight/ui/components/astro/RLAFooter.astro";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";
import { Button, FooterColumns } from "@rimelight/ui/nuxt";
import ThemeToggle from "@rimelight/ui/components/ThemeToggle.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
const today = new Date();

const columns = [
  {
    label: 'Resources',
    children: [
      {
        label: 'Branding',
        to: getRelativeLocaleUrl(Astro.currentLocale ?? 'en', "/branding")
      }
    ]
  },
  {
    label: 'Legal',
    children: [
      {
        label: 'Privacy Policy',
        to: getRelativeLocaleUrl(Astro.currentLocale ?? 'en', "/legal/privacy-policy")
      },
      {
        label: 'Other Documents',
        to: getRelativeLocaleUrl(Astro.currentLocale ?? 'en', "/legal")
      }
    ]
  }
];
---

<RLAFooter contain={false} class="bg-black z-50">
  <div slot="left" class="flex flex-col items-center gap-xs lg:items-start">
    <RLALogo variant="logotype" class="h-6 w-auto" />
    <p class="text-sm text-white">Accessing me.</p>
    <span class="text-sm text-white"> © {today.getFullYear()} idantity.me </span>
  </div>
  <div slot="center">
    <FooterColumns client:load columns={columns} ui={{
      label: 'text-white',
      item: 'text-white',
      link: 'text-white'
    }} />
  </div>
  <div slot="right" class="flex flex-col gap-sm lg:items-end">
    <ThemeToggle size="sm" />
    <div class="flex flex-row gap-sm lg:items-end">
      <Button client:load
        class="text-white hover:text-primary-100"
        color="neutral"
        icon="mdi:instagram"
        size="xl"
        to="https://www.instagram.com/idantity.me"
        variant="ghost"
      />
      <Button client:load
        class="text-white hover:text-primary-100"
        color="neutral"
        icon="ic:baseline-discord"
        size="xl"
        to="https://discord.com/users/682049695173836979"
        variant="ghost"
      />
      <Button client:load
        class="text-white hover:text-primary-100"
        color="neutral"
        icon="mdi:spotify"
        size="xl"
        to="https://open.spotify.com/user/v5m4qoc9j35ccc6nbzqcookvj?si=d795f9bc1cb34222"
        variant="ghost"
      />
      <Button client:load
        class="text-white hover:text-primary-100"
        color="neutral"
        icon="mdi:github"
        size="xl"
        to="https://www.github.com/idantitydotme"
        variant="ghost"
      />
      <Button client:load
        class="text-white hover:text-primary-100"
        color="neutral"
        icon="mdi:linkedin"
        size="xl"
        to="https://www.linkedin.com/daniel-marchi"
        variant="ghost"
      />
    </div>
  </div>
</RLAFooter>
