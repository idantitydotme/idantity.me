---
import RLAFooter from "@rimelight/ui/components/astro/RLAFooter.astro";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import type { ButtonProps } from "@rimelight/ui/types";
import RLALinkGroup from "@rimelight/ui/components/astro/RLALinkGroup.astro";
import RLAThemeSelector from "@rimelight/ui/components/astro/RLAThemeSelector.astro";
import RLALocaleSelector from "@rimelight/ui/components/astro/RLALocaleSelector.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useI18n } from "@rimelight/i18n";

const activeLocale = Astro.currentLocale ?? "en";

const messages = useI18n(Astro, "app_footer", {
  "links_resources_label": "Resources",
  "links_resources_branding": "Branding",
  "links_legal_label": "Legal",
  "links_legal_privacy-policy": "Privacy Policy",
  "links_legal_other-documents": "Other Documents"
});

const columns = [
  {
    label: messages["links_resources_label"],
    children: [
      {
        label: messages["links_resources_branding"],
        to: getRelativeLocaleUrl(activeLocale, "/branding")
      }
    ]
  },
  {
    label: messages["links_legal_label"],
    children: [
      {
        label: messages["links_legal_privacy-policy"],
        to: getRelativeLocaleUrl(activeLocale, "/legal/privacy-policy")
      },
      {
        label: messages["links_legal_other-documents"],
        to: getRelativeLocaleUrl(activeLocale, "/legal")
      }
    ]
  }
];

const socials: ButtonProps[] = [
  {
    leadingIcon: "i-logos-instagram-icon?mask text-white hover:text-primary-500",
    href: "https://www.instagram.com/idantity.me"
  },
  {
    leadingIcon: "i-logos-discord-icon?mask text-white hover:text-primary-500",
    href: "https://discord.com/users/682049695173836979"
  },
  {
    leadingIcon: "i-logos-spotify-icon?mask text-white hover:text-primary-500",
    href: "https://open.spotify.com/user/v5m4qoc9j35ccc6nbzqcookvj?si=d795f9bc1cb34222"
  },
  {
    leadingIcon: "i-logos-github-icon?mask text-white hover:text-primary-500",
    href: "https://www.github.com/idantitydotme"
  },
  {
    leadingIcon: "i-logos-linkedin-icon?mask text-white hover:text-primary-500",
    href: "https://www.linkedin.com/daniel-marchi"
  }
];

const targetLanguages = [
  { code: 'en', label: 'English' },
  { code: 'es', label: 'Español' },
  { code: 'pt', label: "Português" }
];
---

<RLAFooter contain={false} class="bg-black z-50">
  <div slot="left" class="flex flex-col items-center gap-xs lg:items-start">
    <RLALogo variant="logotype" class="h-6 w-auto" />
    <p class="text-sm text-white">Accessing me.</p>
    <span class="text-sm text-white">© {new Date().getFullYear()} idantity.me</span>
  </div>
  <div slot="center" class="flex gap-12">
    {columns.map(column => (
      <RLALinkGroup 
        title={column.label} 
        links={column.children.map(child => ({ label: child.label, href: child.to }))}
        theme="flat"
      />
    ))}
  </div>
  <div slot="right" class="flex flex-col gap-sm lg:items-end">
    <RLAThemeSelector />
    <RLALocaleSelector locales={targetLanguages} />
    <div class="flex flex-row flex-wrap gap-sm lg:items-end">
      {socials.map((social) => (
          <RLAButton
              size="xl"
              color="neutral"
              variant="ghost"
              {...social}
          />
      ))}
    </div>
  </div>
</RLAFooter>
