---
import { createSecurityHead } from "@rimelight/security";
import SEOHead from "@rimelight/seo/components/SEOHead.astro";
import UIHead from "@rimelight/ui/components/head/UIHead.astro";
import AppHeader from '#components/app/AppHeader.astro';
import RLAMain from "@rimelight/ui/components/main/RLAMain.astro"
import AppFooter from '#components/app/AppFooter.astro';
import RLAScrollToTop from "@rimelight/ui/components/scroll-to-top/RLAScrollToTop.astro"
import RLAToaster from "@rimelight/ui/components/toaster/RLAToaster.astro"
import { siteConfig } from "virtual:rimelight/seo";
import { Font } from 'astro:assets';
import { getHtmlLang, getOgLocale, getLanguageAlternates } from '@rimelight/i18n';

interface AppLayoutProps {
	title: string;
	description: string;
	noindex?: boolean;
	is404?: boolean;
	robots?: string;
	languageAlternates?: Array<{ hreflang: string; href: string }>;
	ogImageSrc?: string;
	ogImageAlt?: string;
	favicon?: string;
}

const {
	title,
	description,
	noindex,
	is404,
	robots,
	languageAlternates = getLanguageAlternates(Astro.url.pathname, siteConfig.url),
	ogImageSrc,
	ogImageAlt,
	favicon
} = Astro.props as AppLayoutProps;
---

<!doctype html>
<html lang={getHtmlLang()}>
  <head>
    <SEOHead
      title={title}
      description={description}
      config={siteConfig}
      ogLocale={getOgLocale()}
      rssFeed={{ href: '/rss.xml', title: siteConfig.name }}
      favicon={favicon}
      noindex={noindex}
      is404={is404}
      robots={robots}
      languageAlternates={languageAlternates}
      ogImage={ogImageSrc ? { src: ogImageSrc, alt: ogImageAlt || '' } : undefined}
    />
    <Fragment set:html={createSecurityHead().html} />
    <UIHead />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-serif" />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
	<body class="isolate">
		<AppHeader />
		<RLAMain>
			<slot />
		</RLAMain>
		<AppFooter />
		<RLAScrollToTop showProgress={true} />
		<RLAToaster />
	</body>
</html>
