---
import { createSeoHead } from "@rimelight/seo/head";
import { createSecurityHead } from "@rimelight/security/head";
import { createUiHead } from "@rimelight/ui/head";
import RLAMain from "@rimelight/ui/components/main/RLAMain.astro";
import { siteConfig } from "virtual:rimelight/seo";
import { Font } from 'astro:assets';
import { getHtmlLang, getOgLocale } from '@rimelight/i18n';

interface BlankLayoutProps {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props as BlankLayoutProps;

const seo = createSeoHead({
  title,
  description,
  config: siteConfig,
  ogLocale: getOgLocale(),
  noindex,
  url: Astro.url.href,
  canonical: Astro.url.href
});
const security = createSecurityHead();
const ui = createUiHead();
---

<!doctype html>
<html lang={getHtmlLang()}>
  <head>
    <Fragment set:html={seo.html} />
    <Fragment set:html={security.html} />
    <Fragment set:html={ui.html} />
    <Font cssVariable="--font-sans" preload={true} />
    <Font cssVariable="--font-serif" preload={true} />
    <Font cssVariable="--font-mono" preload={true} />
    <slot name="head" />
  </head>
  <body>
    <RLAMain>
      <slot />
    </RLAMain>
  </body>
</html>
