---
import RLAHead from '@rimelight/ui/components/head/RLAHead.astro';
import RLAMain from "@rimelight/ui/components/main/RLAMain.astro"
import { siteConfig } from "@/config/site.config";
import '@/styles/global.css';
import { Font } from 'astro:assets';

interface ConstructionLayoutProps {
	title: string;
	description: string;
}

const { title, description } = Astro.props as ConstructionLayoutProps;
---

<!doctype html>
<html lang="en">
	<RLAHead title={title} description={description} config={siteConfig}>
		<slot name="head" slot="head" />
		<Font cssVariable="--font-sans" preload={true} slot="head" />
		<Font cssVariable="--font-serif" preload={true} slot="head" />
		<Font cssVariable="--font-mono" preload={true} slot="head" />
	</RLAHead>
	<body class="isolate bg-black">
		<RLAMain>
			<slot />
		</RLAMain>
	</body>
</html>
