{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idantity-dot-me",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "idantity.me",
      "custom_domain": true
    },
    {
      "pattern": "www.idantity.me",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "idantity-dot-me_translations",
      "id": "4600654d2fa04084b7914fa36609e6f5",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "idantity-dot-me",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "namespace_id": "1001",
      "name": "MY_RATE_LIMITER",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "CONSTRUCTION_MODE": "false"
  }
}
