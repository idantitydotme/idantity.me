{
  "name": "idantity-dot-me",
  "version": "0.0.1",
  "private": true,
  "description": "Accessing me.",
  "keywords": [
    "rimelight",
    "solid",
    "typescript"
  ],
  "homepage": "https://idantity.me",
  "bugs": {
    "url": "https://github.com/idantitydotme/idantity.me/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Daniel Marchi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idantitydotme/idantity.me.git"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "prepare": "vp config",
    "generate-types": "wrangler types",
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp build && wrangler dev",
    "profile": "vp build && wrangler check startup",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply idantity-dot-me --local",
    "db:migrate:remote": "wrangler d1 migrations apply idantity-dot-me --remote",
    "check": "pnpm audit && wrangler types && vp check --fix"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.60.1",
    "@rimelight/auth": "0.0.19",
    "@rimelight/cms": "0.0.27",
    "@rimelight/i18n": "0.0.26",
    "@rimelight/security": "0.0.31",
    "@rimelight/seo": "0.0.24",
    "@rimelight/ui": "0.0.70",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.30",
    "@solidjs/signals": "2.0.0-rc.9",
    "@solidjs/vite-plugin": "3.0.0-next.35",
    "@solidjs/web": "2.0.0-rc.9",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.8",
    "solid-js": "2.0.0-rc.9",
    "wrangler": "4.140.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@iconify-json/logos": "1.2.14",
    "@iconify-json/lucide": "1.2.135",
    "@iconify-json/simple-icons": "1.2.53",
    "@rimelight/config": "0.0.29",
    "@types/node": "26.6.2",
    "drizzle-kit": "0.31.11",
    "filesystem-routing": "0.4.0",
    "typescript": "7.0.2",
    "unocss": "66.10.5",
    "vite-plus": "0.3.3"
  },
  "engines": {
    "node": ">=26.8.2"
  },
  "packageManager": "pnpm@12.5.1"
}
