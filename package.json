{
  "name": "idantity-dot-me",
  "version": "0.0.1",
  "private": true,
  "description": "Accessing me.",
  "keywords": [
    "solid",
    "typescript"
  ],
  "homepage": "https://idantity.me",
  "bugs": {
    "url": "https://github.com/idantitydotme/idantity.me/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Daniel Marchi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idantitydotme/idantity.me.git"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "prepare": "vp config",
    "generate-types": "cf workers types",
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "vp build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cf d1 migrations apply idantity-dot-me --dir ./drizzle --local",
    "db:migrate:remote": "cf d1 migrations apply idantity-dot-me --dir ./drizzle",
    "check": "pnpm audit && cf workers types && vp check --fix"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@rimelight/auth": "0.0.24",
    "@rimelight/cms": "0.0.33",
    "@rimelight/i18n": "0.1.0",
    "@rimelight/security": "0.0.38",
    "@rimelight/seo": "0.0.28",
    "@rimelight/ui": "0.0.77",
    "@solidjs/router": "2.0.0-next.35",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@solidjs/web": "2.0.0-rc.13",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "4.13.13",
    "solid-js": "2.0.0-rc.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@iconify-json/logos": "1.2.15",
    "@iconify-json/lucide": "1.2.140",
    "@rimelight/config": "0.0.35",
    "cf": "1.0.0-beta.12",
    "drizzle-kit": "1.0.0-rc.4",
    "filesystem-routing": "0.4.0",
    "typescript": "7.0.2",
    "unocss": "66.10.5",
    "vite-plus": "1.0.0",
    "wrangler": "4.148.0"
  },
  "packageManager": "pnpm@12.10.1"
}
