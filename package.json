{
  "name": "idantity-dot-me",
  "version": "0.0.1",
  "private": true,
  "description": "Accessing me.",
  "keywords": [
    "solid",
    "typescript"
  ],
  "homepage": "https://idantity.me",
  "bugs": {
    "url": "https://github.com/idantitydotme/idantity.me/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Daniel Marchi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idantitydotme/idantity.me.git"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "prepare": "vp config",
    "generate-types": "cf workers types",
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "cf deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cf d1 migrations apply idantity-dot-me --dir ./drizzle --local",
    "db:migrate:remote": "cf d1 migrations apply idantity-dot-me --dir ./drizzle",
    "check": "pnpm audit && cf workers types && vp check --fix"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.4",
    "@rimelight/auth": "0.0.30",
    "@rimelight/cms": "0.0.40",
    "@rimelight/i18n": "0.1.14",
    "@rimelight/security": "0.0.45",
    "@rimelight/seo": "0.0.35",
    "@rimelight/ui": "0.0.85",
    "@solidjs/router": "2.0.0-next.42",
    "@solidjs/vite-plugin": "3.0.0-next.51",
    "@solidjs/web": "2.0.0-rc.18",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "5.0.0-rc.1",
    "solid-js": "2.0.0-rc.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/logos": "1.2.17",
    "@iconify-json/lucide": "1.2.147",
    "@rimelight/config": "0.0.41",
    "cf": "1.0.0-beta.21",
    "drizzle-kit": "1.0.0-rc.5",
    "filesystem-routing": "0.4.1",
    "typescript": "7.1.0-beta",
    "unocss": "66.11.0",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@12.15.0"
}
